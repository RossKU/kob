            amount: gen__token_b_group_escrow1_state.amount - amount_b,
            owner: gen__token_b_group_escrow1_state.owner,
            owner_scheme: OWNER_COVENANT_ID,
            borrow_scheme: gen__token_b_group_escrow1_state.borrow_scheme,
            borrow_guard: gen__token_b_group_escrow1_state.borrow_guard,
            extension_commitment: gen__token_b_group_escrow1_state.extension_commitment,
        };
        KronTokenState a_delivery1 = KronTokenState {
            // :: user declared fields
            owner: byte[32](gen__bids1_bid_state.maker),
            id_type: KRON_ID_ADDRESS,
            amount: n_a1,
            is_minter: 0x00,
        };
        KronTokenState a_change = KronTokenState {
            // :: user declared fields
            owner: byte[32](payer),
            id_type: KRON_ID_ADDRESS,
            amount: gen__token_a_group_mine_state.amount - (n_a1),
            is_minter: 0x00,
        };
        KCC20State b_merchant = KCC20State {
            // :: user declared fields
            amount: amount_b,
            owner: merchant,
            owner_scheme: OWNER_P2PK_SCHNORR,
            borrow_scheme: BORROW_DISABLED,
            borrow_guard: ZERO32,
            extension_commitment: b_extension,
        };
        // :: observed become token_a_group.delivery1 -> self.token_a_type
        validateOutputStateWithInputTemplate(
            gen__token_a_group_delivery1_output_idx,
            a_delivery1,
            gen__token_a_group_mine_input_idx,
            gen__actor_type_self_token_a_type_prefix_len,
            gen__actor_type_self_token_a_type_suffix_len,
            token_a_type
        );
        // :: observed become token_a_group.change -> self.token_a_type
        validateOutputStateWithInputTemplate(
            gen__token_a_group_change_output_idx,
            a_change,
            gen__token_a_group_mine_input_idx,
            gen__actor_type_self_token_a_type_prefix_len,
            gen__actor_type_self_token_a_type_suffix_len,
            token_a_type
        );
        // :: observed become token_b_group.escrow_change -> self.token_b_type
        validateOutputStateWithInputTemplate(
            gen__token_b_group_escrow_change_output_idx,
            b_change,
            gen__token_b_group_escrow1_input_idx,
            gen__actor_type_self_token_b_type_prefix_len,
            gen__actor_type_self_token_b_type_suffix_len,
            token_b_type
        );
        // :: observed become token_b_group.merchant_out -> self.token_b_type
        validateOutputStateWithInputTemplate(
            gen__token_b_group_merchant_out_output_idx,
            b_merchant,
            gen__token_b_group_escrow1_input_idx,
            gen__actor_type_self_token_b_type_prefix_len,
            gen__actor_type_self_token_b_type_suffix_len,
            token_b_type
        );
    }

    // :: leader entry (1:N)
    entry expire(
        int gen__actor_type_self_token_a_type_prefix_len,
        int gen__actor_type_self_token_a_type_suffix_len
    ) {
        // :: observed covenants
        byte[32] gen__token_a_group_cov_id = token_a; // observe token_a_group
        require(OpCovInputCount(gen__token_a_group_cov_id) == 1);
        require(OpCovOutputCount(gen__token_a_group_cov_id) == 1);
        // :: observed input token_a_group.mine: self.token_a_type
        int gen__token_a_group_mine_input_idx = OpCovInputIdx(gen__token_a_group_cov_id, 0);
        KronTokenState gen__token_a_group_mine_state = readInputStateWithTemplate(
            gen__token_a_group_mine_input_idx,
            gen__actor_type_self_token_a_type_prefix_len,
            gen__actor_type_self_token_a_type_suffix_len,
            token_a_type
        );
        // :: observed output token_a_group.back: self.token_a_type
        int gen__token_a_group_back_output_idx = OpCovOutputIdx(gen__token_a_group_cov_id, 0);

        // :: auth outputs
        require(OpAuthOutputCount(this.activeInputIndex) == 0);

        int me = this.activeInputIndex;
        require(tx.time >= deadline);
        require(tx.outputs[me].scriptPubKey == byte[](new ScriptPubKeyP2PK(payer)));
        require(tx.outputs[me].value + EXPIRE_MAX_FEE >= tx.inputs[this.activeInputIndex].value);
        require(OpCovInputIdx(token_a, 0) == me + 1);
        require(OpCovOutputIdx(token_a, 0) == me + 1);
        require(tx.outputs[me + 1].value >= tx.inputs[gen__token_a_group_mine_input_idx].value);
        own_kron(gen__token_a_group_mine_state.owner, gen__token_a_group_mine_state.id_type, gen__token_a_group_mine_state.is_minter, byte[32](OpInputCovenantId(this.activeInputIndex)));
        require(gen__token_a_group_mine_state.amount == lock_amount);
        KronTokenState back_state = KronTokenState {
            // :: user declared fields
            owner: byte[32](payer),
            id_type: KRON_ID_ADDRESS,
            amount: gen__token_a_group_mine_state.amount,
            is_minter: 0x00,
        };
        // :: observed become token_a_group.back -> self.token_a_type
        validateOutputStateWithInputTemplate(
            gen__token_a_group_back_output_idx,
            back_state,
            gen__token_a_group_mine_input_idx,
            gen__actor_type_self_token_a_type_prefix_len,
            gen__actor_type_self_token_a_type_suffix_len,
            token_a_type
        );
    }

    // :: leader entry (1:N)
    entry cancel(
        sig s,
        int gen__actor_type_self_token_a_type_prefix_len,
        int gen__actor_type_self_token_a_type_suffix_len
    ) {
        // :: observed covenants
        byte[32] gen__token_a_group_cov_id = token_a; // observe token_a_group
        require(OpCovInputCount(gen__token_a_group_cov_id) == 1);
        require(OpCovOutputCount(gen__token_a_group_cov_id) == 1);
        // :: observed input token_a_group.mine: self.token_a_type
        int gen__token_a_group_mine_input_idx = OpCovInputIdx(gen__token_a_group_cov_id, 0);
        KronTokenState gen__token_a_group_mine_state = readInputStateWithTemplate(
            gen__token_a_group_mine_input_idx,
            gen__actor_type_self_token_a_type_prefix_len,
            gen__actor_type_self_token_a_type_suffix_len,
            token_a_type
        );
        // :: observed output token_a_group.back: self.token_a_type
        int gen__token_a_group_back_output_idx = OpCovOutputIdx(gen__token_a_group_cov_id, 0);

        // :: auth outputs
        require(OpAuthOutputCount(this.activeInputIndex) == 0);

        require_cancel_sig(s, payer);
        require(OpCovInputIdx(token_a, 0) == this.activeInputIndex + 1);
        require(gen__token_a_group_mine_state.owner == byte[32](OpInputCovenantId(this.activeInputIndex)));
        require(gen__token_a_group_mine_state.id_type == KRON_ID_COVENANT);
        require(gen__token_a_group_mine_state.amount == lock_amount);
    }

}
