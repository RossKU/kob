        );
    }

    // :: leader entry (1:N)
    entry cancel(
        sig s,
        int gen__actor_type_self_token_type_prefix_len,
        int gen__actor_type_self_token_type_suffix_len
    ) {
        // :: observed covenants
        byte[32] gen__token_cov_id = token_covid; // observe token
        require(OpCovInputCount(gen__token_cov_id) == 1);
        require(OpCovOutputCount(gen__token_cov_id) == 1);
        // :: observed input token.mine: self.token_type
        int gen__token_mine_input_idx = OpCovInputIdx(gen__token_cov_id, 0);
        KCC20State gen__token_mine_state = readInputStateWithTemplate(
            gen__token_mine_input_idx,
            gen__actor_type_self_token_type_prefix_len,
            gen__actor_type_self_token_type_suffix_len,
            token_type
        );
        // :: observed output token.back: self.token_type
        int gen__token_back_output_idx = OpCovOutputIdx(gen__token_cov_id, 0);

        // :: auth outputs
        require(OpAuthOutputCount(this.activeInputIndex) == 0);

        require_cancel_sig(s, payer);
        require(OpCovInputIdx(token_covid, 0) == this.activeInputIndex + 1);
        require(gen__token_mine_state.owner == byte[32](OpInputCovenantId(this.activeInputIndex)));
        require(gen__token_mine_state.owner_scheme == OWNER_COVENANT_ID);
        require(gen__token_mine_state.amount == lock_amount);
        require(gen__token_mine_state.extension_commitment == lock_extension);
    }

}
