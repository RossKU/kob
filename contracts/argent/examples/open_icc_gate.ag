// Third-party example, OPEN ICC (inter-covenant composition): the ask template is data, not a link.
//
// Same `PriceGate` idea as closed_icc_gate.ag, but the ask handle is a state field of the actor,
// `actor_type<KobAskState> ask_type`. The instance is created with the published KobAsk template hash
// (contracts/argent/KOBOrders/artifact.json, actor KobAsk, actor_type_handle), and the contract
// lowers the observation to readInputStateWithTemplate with that hash and witness-supplied
// prefix/suffix lengths. It needs no artifact-backed import, hence not argentc patch 0002.
//
// The importer must declare the state layout itself, with the published state name (argent-runtime
// matches an open handle by state name; the layout is published in the KOBOrders artifact,
// argent.states). NOTE: the KobAskState below stops at priceEnd, whereas the published layout
// (contracts/argent/KOBOrders.ag) has 19 fields and ends with decayStep and amountLeft; this example
// only reads price and tif and is compile-checked only.
//
// Compiled by scripts/build-argent.sh so it cannot rot (generated SilverScript:
// contracts/argent/examples-out/open_icc_gate/); it is not a KOB contract.

state KobAskState {
    pubkey maker;
    byte[32] tokenCovId;
    byte[32] tokenTplHash;
    int tplPrefixLen;
    int tplSuffixLen;
    int scale;
    int minFill;
    int price;
    int tip;
    int tif;
    int activeFrom;
    int expiryDaa;
    int refundTip;
    int interval;
    int maxFill;
    int slope;
    int priceEnd;
}

state OpenPriceGateState {
    pubkey owner;
    int max_price;
    actor_type<KobAskState> ask_type;
}

actor OpenPriceGate owns OpenPriceGateState {
    entry spend(cov_id ask_covid, sig s)
    observes book by ask_covid {
        inputs {
            ask: self.ask_type,
        }
        outputs {
            next: self.ask_type,
        }
    }
    emits none {
        KobAskState a = state(book.inputs.ask);
        require(a.price <= max_price);
        require(a.tif == 0);
        require book.outputs become {
            next <- self.ask_type(a),
        };
        require(checkSig(s, owner));
    }
}

app OpenPriceGateApp {
    actor OpenPriceGate;
}
