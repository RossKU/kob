// A third-party example of open ICC (inter-covenant composition). The ask
// template is data in the state, not a link.
//
// It is the PriceGate of closed_icc_gate.ag with the ask handle as a state
// field, `actor_type<KobAskState> ask_type`. An instance is created with the
// KobAsk actor_type_handle of contracts/argent/KOBOrders/artifact.json, and
// argentc lowers the observation to readInputStateWithTemplate with it. It
// needs no artifact-backed import, so no argentc patch 0002.
//
// The importer declares the state itself, under the published state name,
// because argent-runtime matches an open handle by state name. This example
// only shows the syntax. Its KobAskState stops at priceEnd, where the
// published layout has 20 fields, and it pins an unchanged continuation,
// which a KobAsk never produces. It is compile-checked only.
//
// scripts/build-argent.sh compiles it and publishes its SilverScript in
// contracts/argent/examples-out/open_icc_gate/. It is not a KOB contract.

state KobAskState {
    pubkey maker;
    byte[32] tokenCovId;
    byte[32] tokenTplHash;
    int tplPrefixLen;
    int tplSuffixLen;
    int scale;
    int minFill;
    int price;
    int tip;
    int tif;
    int activeFrom;
    int expiryDaa;
    int refundTip;
    int interval;
    int maxFill;
    int slope;
    int priceEnd;
}

state OpenPriceGateState {
    pubkey owner;
    int max_price;
    actor_type<KobAskState> ask_type;
}

actor OpenPriceGate owns OpenPriceGateState {
    entry spend(cov_id ask_covid, sig s)
    observes book by ask_covid {
        inputs {
            ask: self.ask_type,
        }
        outputs {
            next: self.ask_type,
        }
    }
    emits none {
        KobAskState a = state(book.inputs.ask);
        require(a.price <= max_price);
        require(a.tif == 0);
        require book.outputs become {
            next <- self.ask_type(a),
        };
        require(checkSig(s, owner));
    }
}

app OpenPriceGateApp {
    actor OpenPriceGate;
}
