// A third-party example of closed ICC (inter-covenant composition). It
// imports the published KOBOrders artifact, see docs/argent/argent.md,
// "Importing KOBOrders from another Argent app".
//
// PriceGate is a KAS lock that can be spent only next to a partial fill of a
// KOB ask with tif 0 and a price of at most max_price sompi per whole token.
// The fill continues the ask with amountLeft - n and every other field
// unchanged, so the gate pins exactly that next state. A gate that pinned an
// unchanged continuation could never be spent.
//
// The handle KOBOrders::KobAsk names the ask. argentc links its published
// template hash and reads the ask's state with the published layout. The
// import pins the artifact id (argentc patch 0002), because a forged artifact
// with the same app name and ABI is self-consistent too. Pin the id you
// reviewed with `sil2argent verify`.
//
// scripts/build-argent.sh compiles it and publishes its SilverScript in
// contracts/argent/examples-out/closed_icc_gate/. It is not a KOB contract.

import "../KOBOrders/artifact.json" id "aaaf060e2c4d998289c292778625e2e11f25a44b2ec27a2b33a2b93d305cd907";

state PriceGateState {
    pubkey owner;
    int max_price;
}

actor PriceGate owns PriceGateState {
    entry spend(cov_id ask_covid, int n, sig s)
    observes book by ask_covid {
        inputs {
            ask: KOBOrders::KobAsk,
        }
        outputs {
            next: KOBOrders::KobAsk,
        }
    }
    emits none {
        require(book.inputs.ask.price <= max_price);
        require(book.inputs.ask.tif == 0);
        require(n > 0);
        require(n < book.inputs.ask.amountLeft);
        KobAskState next_a = KobAskState {
            maker: book.inputs.ask.maker,
            tokenCovId: book.inputs.ask.tokenCovId,
            tokenTplHash: book.inputs.ask.tokenTplHash,
            tplPrefixLen: book.inputs.ask.tplPrefixLen,
            tplSuffixLen: book.inputs.ask.tplSuffixLen,
            scale: book.inputs.ask.scale,
            minFill: book.inputs.ask.minFill,
            price: book.inputs.ask.price,
            tip: book.inputs.ask.tip,
            tif: book.inputs.ask.tif,
            activeFrom: book.inputs.ask.activeFrom,
            expiryDaa: book.inputs.ask.expiryDaa,
            refundTip: book.inputs.ask.refundTip,
            interval: book.inputs.ask.interval,
            maxFill: book.inputs.ask.maxFill,
            slope: book.inputs.ask.slope,
            priceEnd: book.inputs.ask.priceEnd,
            decayStep: book.inputs.ask.decayStep,
            amountLeft: book.inputs.ask.amountLeft - n,
            extensionCommitment: book.inputs.ask.extensionCommitment,
        };
        require book.outputs become {
            next <- KOBOrders::KobAsk(next_a),
        };
        require(checkSig(s, owner));
    }
}

app PriceGateApp {
    actor PriceGate;
}
