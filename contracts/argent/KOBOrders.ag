// KOBOrders: Argent interface of the nine hand-written KOB contracts (protocol v3) in contracts/v2/*.sil
// (KobAsk, KobBid, KobCondAsk, KobCondBid, KobIfdAsk, KobIfdBid, and the pair orders KobPair, KobCondPair, KobIfdPair).
//
// THIS FILE IS NOT THE IMPLEMENTATION. The order programs are hand-written SilverScript shipped as
// silverc artifacts (contracts/artifacts/*.json). For each of them this file declares only
//   1. the state layout: the same field names, order and Sil types as the contract's state span
//      (what `actor_type<State>` handles and observed inputs read);
//   2. the entries: the same names and argument types, plus the continuations an entry may
//      create (`emits`).
// The entry bodies are placeholders. scripts/build-argent.sh compiles this file with argentc into a
// skeleton artifact; tools/sil2argent refuses it if a state or entry ABI differs from the .sil, then
// replaces every generated contract by the silverc output and recomputes template receipts,
// actor-type handles, interface fingerprints and the artifact id. Result:
// contracts/argent/KOBOrders/artifact.json (generated; see docs/argent.md, argent/UPSTREAM.md).
//
// The 8/8 KCC-20 token prototype is the separate single-actor app KOBToken (kcc20_8x8.ag; KOB issues the
// standard 3/3 reference, built the same way from kcc20.ag): an actor in a multi-actor app gets
// compiler-owned template fields, which would change the token program.
//
// `emits` lists only continuations that stay in the entry's own covenant (authorised outputs of the
// input's covenant id). The exit orders that KobIfd* create are fresh genesis covenants, which
// consensus hides from authorised-output accounting, so they are not emits (the same for the KobCondPair exits of
// KobIfdPair); the token outputs an
// order pins belong to the token program and are not emits either. What each order really enforces
// is in the .sil and its tests (crates/kob-tests), not in this file.
//
// State: orders keep remaining size and lifecycle flags in mutable state fields (amountLeft, armed, ...;
// the token custody of a sell-side order holds exactly amountLeft base units, of the extension commitment its state
// names: extensionCommitment of KobAsk / KobCondAsk, the committed exit's of KobIfdAsk, sExt / aExt / bExt of the pair
// orders), so a partial fill or an update continues with a DIFFERENT state. Readers of an observed order must not assume a byte-identical
// continuation.
//
// Build constants (inlined in the .sil, fixed by contracts/v2/*.ctor.json): KobCondAsk / KobCondBid
// embed the KobAsk and KobBid templates (their trigger evidence is a fill of such an order in the same
// transaction); KobIfdBid / KobIfdAsk embed the exit template and the evidence template of their stop
// entry; KobCondPair embeds the KobAsk and KobBid templates of both families and KobPair (its trigger evidence: two
// KAS-book fills or a resting pair order); KobIfdPair embeds its exit KobCondPair and the same evidence templates. None
// depends on a network or a genesis, so the published artifact is final on every network.

state KobAskState {
    pubkey maker;
    byte[32] tokenCovId;
    byte[32] tokenTplHash;
    int tplPrefixLen;
    int tplSuffixLen;
    int scale;
    int minFill;
    int price;
    int tip;
    int tif;
    int activeFrom;
    int expiryDaa;
    int refundTip;
    int interval;
    int maxFill;
    int slope;
    int priceEnd;
    int decayStep;
    int amountLeft;
    byte[32] extensionCommitment;
}

state KobBidState {
    pubkey maker;
    byte[32] tokenCovId;
    byte[32] tokenTplHash;
    int tplPrefixLen;
    int tplSuffixLen;
    byte[32] extensionCommitment;
    int scale;
    int minFill;
    int price;
    int tip;
    int tif;
    int activeFrom;
    int expiryDaa;
    int refundTip;
    int reserve;
    int deliveryCarrier;
    int interval;
    int maxFill;
    int slope;
    int priceEnd;
    int decayStep;
}

