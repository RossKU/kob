// KOBOrders: the Argent interface of KOB's nine hand-written order contracts.
//
// The orders are SilverScript, in contracts/orders/*.sil: KobAsk, KobBid,
// KobCondAsk, KobCondBid, KobIfdAsk, KobIfdBid, KobPair, KobCondPair and
// KobIfdPair. This file is not their implementation. For each order it
// declares only:
//   1. the state layout, with the field names, order and types of the
//      contract's state span;
//   2. the entries, with their argument types and the continuations each may
//      create (`emits`).
// The entry bodies are placeholders. What an order enforces is in its .sil
// file and in the tests under crates/kob-tests.
//
// Build. scripts/build-argent.sh compiles this file into a skeleton artifact.
// tools/sil2argent refuses it if a state or entry ABI differs from the .sil.
// It then swaps in the silverc output and recomputes the template receipts,
// actor-type handles, interface fingerprints and the artifact id. The result
// is contracts/argent/KOBOrders/artifact.json, see docs/argent/argent.md.
//
// `emits` lists only continuations in the entry's own covenant. The exits
// that KobIfd* orders create are fresh genesis covenants, which consensus
// leaves out of authorised-output accounting, so they are not listed. Token
// outputs belong to the token program and are not listed either.
//
// Orders keep their remaining size and lifecycle flags (amountLeft, armed) in
// mutable fields, so a partial fill or an update continues with a different
// state. A reader of an observed order must not assume a byte-identical
// continuation.
//
// The templates an order embeds, for trigger evidence and exits, are fixed by
// contracts/orders/*.ctor.json and depend on no network or genesis. The
// published artifact is therefore final on every network.
//
// The 8/8 KCC-20 prototype is a separate app, KOBToken (kcc20_8x8.ag). An
// actor in a multi-actor app gets compiler-owned template fields, and those
// would change the token program.

state KobAskState {
    pubkey maker;
    byte[32] tokenCovId;
    byte[32] tokenTplHash;
    int tplPrefixLen;
    int tplSuffixLen;
    int scale;
    int minFill;
    int price;
    int tip;
    int tif;
    int activeFrom;
    int expiryDaa;
    int refundTip;
    int interval;
    int maxFill;
    int slope;
    int priceEnd;
    int decayStep;
    int amountLeft;
    byte[32] extensionCommitment;
}

state KobBidState {
    pubkey maker;
    byte[32] tokenCovId;
    byte[32] tokenTplHash;
    int tplPrefixLen;
    int tplSuffixLen;
    byte[32] extensionCommitment;
    int scale;
    int minFill;
    int price;
    int tip;
    int tif;
    int activeFrom;
    int expiryDaa;
    int refundTip;
    int reserve;
    int deliveryCarrier;
    int interval;
    int maxFill;
    int slope;
    int priceEnd;
    int decayStep;
}

