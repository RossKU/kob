    pubkey maker;
    byte[32] tokenCovId;
    byte[32] tokenTplHash;
    int tplPrefixLen;
    int tplSuffixLen;
    int scale;
    int minFill;
    int tip;
    int activeFrom;
    int expiryDaa;
    int refundTip;
    int tpPrice;
    int stopPrice;
    int slipBps;
    int trailStep;
    int trailGap;
    int trailWait;
    int minTouch;
    int minRestDaa;
    int armed;
    int bandDaa;
    int keeperTip;
    int amountLeft;
    byte[32] parent;
    int rptPrice;
    int rptUntil;
    byte[32] extensionCommitment;
}

state KobCondBidState {
    pubkey maker;
    byte[32] tokenCovId;
    byte[32] tokenTplHash;
    int tplPrefixLen;
    int tplSuffixLen;
    byte[32] extensionCommitment;
    int scale;
    int minFill;
    int tip;
    int activeFrom;
    int expiryDaa;
    int refundTip;
    int deliveryCarrier;
    int tpPrice;
    int stopPrice;
    int slipBps;
    int trailStep;
    int trailGap;
    int trailWait;
    int minTouch;
    int minRestDaa;
    int amountLeft;
    int armed;
    int bandDaa;
    int keeperTip;
    byte[32] parent;
    int rptPrice;
    int rptPre;
    int rptUntil;
}

state KobIfdAskState {
    pubkey maker;
    byte[32] tokenCovId;
    byte[32] tokenTplHash;
    int tplPrefixLen;
    int tplSuffixLen;
    int scale;
    int price;
    int tip;
    int activeFrom;
    int expiryDaa;
    int refundTip;
    int prefund;
    int exitCarrier;
    int minFill;
    int entryStop;
    int bandDaa;
    int minTouch;
    int minRestDaa;
    int keeperTip;
    int armed;
    int amountLeft;
    int rptAmount;
    byte[321] exitState;
}

state KobIfdBidState {
    pubkey maker;
    byte[32] tokenCovId;
    byte[32] tokenTplHash;
    int tplPrefixLen;
    int tplSuffixLen;
    byte[32] extensionCommitment;
    int scale;
    int amountLeft;
    int price;
    int tip;
    int activeFrom;
    int expiryDaa;
    int refundTip;
    int deliveryCarrier;
    int exitCarrier;
    int minFill;
    int entryStop;
    int bandDaa;
    int minTouch;
    int minRestDaa;
    int keeperTip;
    int armed;
    int rptAmount;
    byte[279] exitState;
