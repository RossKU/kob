    int tip;
    int activeFrom;
    int expiryDaa;
    int refundTip;
    int tpPrice;
    int stopPrice;
    int slipBps;
    int trailStep;
    int trailGap;
    int trailWait;
    int minTouch;
    int minRestDaa;
    int armed;
    int bandDaa;
    int keeperTip;
    int amountLeft;
    byte[32] parent;
    int rptPrice;
    int rptUntil;
    byte[32] extensionCommitment;
}

