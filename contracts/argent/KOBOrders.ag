// The pair orders. One template serves both sides, side 1 (an ask, which
// sells the base token A) and side 2 (a bid, which buys A). It also serves
// both token families of A and B (sFamily and tFamily, or aFamily and
// bFamily). S is the token an order holds, A for an ask and B for a bid. T is
// the token it buys.
state KobPairState {
    pubkey maker;
    int side;
    byte[32] sCovId;
    byte[32] sTplHash;
    int sPre;
    int sSuf;
    int sFamily;
    int sScale;
    byte[32] tCovId;
    byte[32] tTplHash;
    int tPre;
    int tSuf;
    int tFamily;
    byte[32] tExt;
    int tScale;
    int minFill;
    int price;
    int tip;
    int tif;
    int activeFrom;
    int expiryDaa;
    int refundTip;
    int deliveryCarrier;
    int interval;
    int maxFill;
    int slope;
    int priceEnd;
    int decayStep;
    int amountLeft;
    int custody;
    byte[32] sExt;
}

state KobCondPairState {
    pubkey maker;
    int side;
    byte[32] sCovId;
    byte[32] sTplHash;
    int sPre;
    int sSuf;
    int sFamily;
    int sScale;
    byte[32] tCovId;
    byte[32] tTplHash;
    int tPre;
    int tSuf;
    int tFamily;
    byte[32] tExt;
    int tScale;
    int minFill;
    int tip;
    int activeFrom;
    int expiryDaa;
    int refundTip;
    int deliveryCarrier;
    int tpPrice;
    int slipBps;
    int trailStep;
    int trailGap;
    int trailWait;
    int minTouch;
    int minRestDaa;
    int bandDaa;
    int keeperTip;
    int stopPrice;
    int armed;
    int amountLeft;
    int custody;
    byte[32] parent;
    int rptPrice;
    int rptPre;
    int rptUntil;
    byte[32] sExt;
}

state KobIfdPairState {
    pubkey maker;
    int side;
    byte[32] aCovId;
    byte[32] aTplHash;
    int aPre;
    int aSuf;
    int aFamily;
    int aScale;
    byte[32] aExt;
    byte[32] bCovId;
    byte[32] bTplHash;
    int bPre;
    int bSuf;
    int bFamily;
    int bScale;
    byte[32] bExt;
    int price;
    int prefund;
    int tip;
    int activeFrom;
    int expiryDaa;
    int refundTip;
    int deliveryCarrier;
    int exitCarrier;
    int minFill;
    int entryStop;
    int bandDaa;
    int minTouch;
    int minRestDaa;
    int keeperTip;
    int armed;
    int amountLeft;
    int custody;
    int rptAmount;
    byte[432] exitState;
}

// ---------------------------------------- limit orders

actor KobAsk owns KobAskState {
    // Fill n base units, or refund the order with n == 0. nb is n as 8 bytes,
    // little-endian. A GTC rest continues with amountLeft - n. A sold-out,
    // IOC or FOK fill ends the order.
    entry settle(byte[8] nb, int tokenIn, int tokOut, int t) emits {
        next: KobAsk[0..=1],
    } {
        KobAskState[] cont;
        unrestricted(next[0].value);
        become next <- KobAsk[](cont);
    }

    entry cancel(sig s) emits none {
        require(checkSig(s, maker));
    }
}

actor KobBid owns KobBidState {
    entry fill(byte[8] nb, int tokenTplIn, int t) emits {
        next: KobBid[0..=1],
    } {
        KobBidState[] cont;
        unrestricted(next[0].value);
        become next <- KobBid[](cont);
    }

    entry cancel(sig s) emits none {
        require(checkSig(s, maker));
    }

    entry refund() emits none {
        require(true);
    }
}

// ---------------------------------------- pair orders (token A / token B)

actor KobPair owns KobPairState {
    // Fill n base units of A, or refund the order with n == 0. nb is n as 8
    // bytes, little-endian. The maker receives T as tOut, at output i.
    //   Ask  Release n of A and receive at least ceil(n * price(t) / scale(A))
    //        of B.
    //   Bid  Pay exactly floor(n * price(t) / scale(A)) of B from the escrow
    //        and receive n of A.
    // The order enforces only its own terms, so any counterparty may settle
    // it, such as the KAS books of both tokens, opposite pair orders or
    // inventory. A GTC rest continues with amountLeft - n and the rest of the
    // custody. A sold-out, IOC or FOK fill ends the order.
    entry settle(byte[8] nb, int custIn, int tTplIn, int t, int sOut, int tOut) emits {
        next: KobPair[0..=1],
    } {
        KobPairState[] cont;
        unrestricted(next[0].value);
        become next <- KobPair[](cont);
    }

    entry cancel(sig s) emits none {
        require(checkSig(s, maker));
    }
}

actor KobCondPair owns KobCondPairState {
    // One entry for fill, refund and update, chosen by nb and upd.
    //   nb > 0, upd 0   Fill on leg 0 (take-profit or limit) or leg 1 (stop).
    //                   An unarmed stop arms in the fill, from the trigger
    //                   evidence evA, evB, tk and evMode. The evidence is two
    //                   filled KAS-book orders of A and B, or a filled resting
    //                   KobPair.
    //   nb == 0, upd 0  Refund.
    //   nb == 0, upd 1  Update. k == 0 arms the stop, k > 0 trails it by k
    //                   steps.
    // The take-profit fill of a booked exit re-arms its KobIfdPair entry,
    // which is spent in the same transaction.
    entry settle(byte[8] nb, int custIn, int tTplIn, int t, int sOut, int tOut, int leg, int evA, int evB, int tk, int evMode,
                 int upd, int k) emits {
        next: KobCondPair[0..=1],
    } {
        KobCondPairState[] cont;
        unrestricted(next[0].value);
        become next <- KobCondPair[](cont);
    }

    entry cancel(sig s) emits none {
        require(checkSig(s, maker));
    }
}

actor KobIfdPair owns KobIfdPairState {
    // One entry for fill, merge, refund and update, chosen by nb and upd.
    //   nb > 0          Fill.
    //   nb < 0          Merge. Re-arm the entry next to the take-profit fill
    //                   of a booked exit.
    //   nb == 0, upd 0  Refund.
    //   nb == 0, upd 1  Update. Arm a stop entry.
    // Every fill creates its exit, a fresh KobCondPair genesis covenant, which
    // is not an emit. A repeating entry keeps its covenant across fills, with
    // new armed, amountLeft, custody and rptAmount.
    entry fill(byte[8] nb, int aIn, int bIn, int aTplIn, int bTplIn, int exitOut, int amt, byte[] cPre, byte[] cSuf,
               int evA, int evB, int tk, int evMode, int t, int aOut, int bOut, int xc, int upd) emits {
        next: KobIfdPair[0..=1],
    } {
        KobIfdPairState[] cont;
        unrestricted(next[0].value);
        become next <- KobIfdPair[](cont);
    }

    entry cancel(sig s) emits none {
        require(checkSig(s, maker));
    }
}

// ---------------------------------------- conditional orders

actor KobCondAsk owns KobCondAskState {
    entry settle(byte[8] nb, int tokenIn, int tokOut, int leg, int ev, int tk, int t) emits {
        next: KobCondAsk[0..=1],
    } {
        KobCondAskState[] cont;
        unrestricted(next[0].value);
        become next <- KobCondAsk[](cont);
    }

    entry update(int ev, int tk) emits {
        next: KobCondAsk[1..=1],
    } {
        KobCondAskState[] cont;
        unrestricted(next[0].value);
        become next <- KobCondAsk[](cont);
    }

    entry cancel(sig s) emits none {
        require(checkSig(s, maker));
    }
}

actor KobCondBid owns KobCondBidState {
    entry settle(byte[8] nb, int tokenTplIn, int leg, int ev, int t) emits {
        next: KobCondBid[0..=1],
    } {
        KobCondBidState[] cont;
        unrestricted(next[0].value);
        become next <- KobCondBid[](cont);
    }

    entry update(int ev, int tk) emits {
        next: KobCondBid[1..=1],
    } {
        KobCondBidState[] cont;
        unrestricted(next[0].value);
        become next <- KobCondBid[](cont);
    }

    entry cancel(sig s) emits none {
        require(checkSig(s, maker));
    }

    entry refund() emits none {
        require(true);
    }
}

// ---------------------------------------- if-done orders

actor KobIfdAsk owns KobIfdAskState {
    // The exit KobCondBid is a fresh genesis covenant, not an emit. A repeating
    // entry keeps its covenant across fills, with new armed, amountLeft and
    // rptAmount, until `close`.
    entry settle(byte[8] nb, int tokenIn, int tokOut, int exitOut, byte[] cPre, byte[] cSuf, int ev, int tk, int t) emits {
        next: KobIfdAsk[0..=1],
    } {
        KobIfdAskState[] cont;
        unrestricted(next[0].value);
        become next <- KobIfdAsk[](cont);
    }

    entry close() emits none {
        require(true);
    }

    // Arm a stop entry. The continuation differs only in `armed`. It needs
    // amountLeft > 0 and entryStop >= price.
    entry update(int ev, int tk) emits {
        next: KobIfdAsk[1..=1],
    } {
        KobIfdAskState[] cont;
        unrestricted(next[0].value);
        become next <- KobIfdAsk[](cont);
    }

    entry cancel(sig s) emits none {
        require(checkSig(s, maker));
    }
}

actor KobIfdBid owns KobIfdBidState {
    // The exit KobCondAsk is a fresh genesis covenant, not an emit.
    entry fill(byte[8] nb, int tokenTplIn, int exitOut, byte[] cPre, byte[] cSuf, int ev, int t) emits {
        next: KobIfdBid[0..=1],
    } {
        KobIfdBidState[] cont;
        unrestricted(next[0].value);
        become next <- KobIfdBid[](cont);
    }

    // Arm a stop entry. The continuation differs only in `armed`. It needs
    // amountLeft > 0 and entryStop <= price.
    entry update(int ev) emits {
        next: KobIfdBid[1..=1],
    } {
        KobIfdBidState[] cont;
        unrestricted(next[0].value);
        become next <- KobIfdBid[](cont);
    }

    entry cancel(sig s) emits none {
        require(checkSig(s, maker));
    }

    entry refund() emits none {
        require(true);
    }
}

app KOBOrders {
    actor KobAsk;
    actor KobBid;
    actor KobCondAsk;
    actor KobCondBid;
    actor KobIfdAsk;
    actor KobIfdBid;
    actor KobPair;
    actor KobCondPair;
    actor KobIfdPair;
}
