    pubkey maker;
    byte[32] tokenCovId;
    byte[32] tokenTplHash;
    int tplPrefixLen;
    int tplSuffixLen;
    byte[32] extensionCommitment;
    int scale;
    int minFill;
    int tip;
    int activeFrom;
    int expiryDaa;
    int refundTip;
    int deliveryCarrier;
    int tpPrice;
    int stopPrice;
    int slipBps;
    int trailStep;
    int trailGap;
    int trailWait;
    int minTouch;
    int minRestDaa;
    int amountLeft;
    int armed;
    int bandDaa;
    int keeperTip;
    byte[32] parent;
    int rptPrice;
    int rptPre;
    int rptUntil;
}

