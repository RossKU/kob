    // The payer, at any time. Input j + 1 must be the lock, the one token
    // input of the locked token, read under the intent's handle and owned by
    // this intent's id. The cancel ends the intent covenant, and tokens owned
    // by its id could never move afterwards. The payer's SIGHASH_ALL
    // signature chooses where the one token output goes.
    entry cancel(sig s)
    observes token_a_group by self.token_a {
        inputs {
            mine: self.token_a_type,
        }
        outputs {
            back: self.token_a_type,
        }
    }
    emits none {
        require_cancel_sig(s, payer);
        require(OpCovInputIdx(token_a, 0) == this.activeInputIndex + 1);
        require(token_a_group.inputs.mine.owner == byte[32](self.cov_id));
        require(token_a_group.inputs.mine.owner_scheme == OWNER_COVENANT_ID);
        require(token_a_group.inputs.mine.borrow_scheme == BORROW_DISABLED);
        require(token_a_group.inputs.mine.amount == lock_amount);
        require(token_a_group.inputs.mine.extension_commitment == lock_extension);
    }
}

actor TokenSwap_swap2 owns TokenSwapState {
    // 2 bids and 2 asks. Every bid but the last ends, and every ask but
    // the last is sold out. The last bid rests, and the last ask rests.
    entry swap2(cov_id bid1_covid, cov_id bid2_covid, cov_id ask1_covid, cov_id ask2_covid, int n_a1, int n_a2)
    observes bids1 by bid1_covid {
        inputs {
            bid: KOBOrders::KobBid,
        }
        outputs {
        }
    }
    observes bids2 by bid2_covid {
        inputs {
            bid: KOBOrders::KobBid,
        }
        outputs {
            next: KOBOrders::KobBid,
        }
    }
    observes asks1 by ask1_covid {
        inputs {
            ask: KOBOrders::KobAsk,
        }
        outputs {
        }
    }
    observes asks2 by ask2_covid {
        inputs {
            ask: KOBOrders::KobAsk,
        }
        outputs {
            next: KOBOrders::KobAsk,
        }
    }
    observes token_a_group by self.token_a {
        inputs {
            mine: self.token_a_type,
        }
        outputs {
            delivery1: self.token_a_type,
            delivery2: self.token_a_type,
            change: self.token_a_type,
        }
    }
    observes token_b_group by self.token_b {
        inputs {
            escrow1: self.token_b_type,
            escrow2: self.token_b_type,
        }
        outputs {
            escrow_change: self.token_b_type,
            merchant_out: self.token_b_type,
        }
    }
    emits none {
        require(tx.inputs.length == this.activeInputIndex + 1);
        require(OpTxInputScriptSigSubstr(OpCovInputIdx(ask1_covid, 0), 0, 1) == byte[](0x08));
        require(int(byte[8](OpTxInputScriptSigSubstr(OpCovInputIdx(ask1_covid, 0), 1, 9))) > 0);
        require(OpTxInputScriptSigSubstr(OpCovInputIdx(ask2_covid, 0), 0, 1) == byte[](0x08));
        require(int(byte[8](OpTxInputScriptSigSubstr(OpCovInputIdx(ask2_covid, 0), 1, 9))) > 0);

        require(token_a != token_b);
        own_tokens(token_a_group.inputs.mine.owner, token_a_group.inputs.mine.owner_scheme, token_a_group.inputs.mine.borrow_scheme, byte[32](self.cov_id));
        require(token_a_group.inputs.mine.amount == lock_amount);
        require(token_a_group.inputs.mine.extension_commitment == lock_extension);
        bid_fits(bids1.inputs.bid.tokenCovId, byte[32](token_a), n_a1);
        bid_fits(bids2.inputs.bid.tokenCovId, byte[32](token_a), n_a2);
        require(bids2.inputs.bid.tif == 0);
        require(n_a1 + n_a2 <= max_sell_a);
        require(n_a1 + n_a2 <= token_a_group.inputs.mine.amount);
        require((amount_b - token_b_group.inputs.escrow1.amount) < token_b_group.inputs.escrow2.amount);
        require(asks2.inputs.ask.tif == 0);
        require(token_b_group.inputs.escrow1.extension_commitment == b_extension);
        require(token_b_group.inputs.escrow2.extension_commitment == b_extension);
        ask_fits(asks1.inputs.ask.tokenCovId, asks1.inputs.ask.amountLeft, token_b_group.inputs.escrow1.owner, token_b_group.inputs.escrow1.owner_scheme, token_b_group.inputs.escrow1.amount, byte[32](ask1_covid), byte[32](token_b), token_b_group.inputs.escrow1.amount);
        ask_fits(asks2.inputs.ask.tokenCovId, asks2.inputs.ask.amountLeft, token_b_group.inputs.escrow2.owner, token_b_group.inputs.escrow2.owner_scheme, token_b_group.inputs.escrow2.amount, byte[32](ask2_covid), byte[32](token_b), (amount_b - token_b_group.inputs.escrow1.amount));

        require(OpCovOutputIdx(token_b, 1) == this.activeInputIndex);
        require(OpCovOutputIdx(token_a, 2) == this.activeInputIndex + 1);

        KCC20State b_change = {
            amount: token_b_group.inputs.escrow2.amount - (amount_b - token_b_group.inputs.escrow1.amount),
            owner: token_b_group.inputs.escrow2.owner,
            owner_scheme: OWNER_COVENANT_ID,
            borrow_scheme: token_b_group.inputs.escrow2.borrow_scheme,
            borrow_guard: token_b_group.inputs.escrow2.borrow_guard,
            extension_commitment: token_b_group.inputs.escrow2.extension_commitment,
        };
        KCC20State a_delivery1 = {
            amount: n_a1,
            owner: byte[32](bids1.inputs.bid.maker),
            owner_scheme: OWNER_P2PK_SCHNORR,
            borrow_scheme: BORROW_DISABLED,
            borrow_guard: ZERO32,
            extension_commitment: bids1.inputs.bid.extensionCommitment,
        };
        KCC20State a_delivery2 = {
            amount: n_a2,
            owner: byte[32](bids2.inputs.bid.maker),
            owner_scheme: OWNER_P2PK_SCHNORR,
            borrow_scheme: BORROW_DISABLED,
            borrow_guard: ZERO32,
            extension_commitment: bids2.inputs.bid.extensionCommitment,
        };
        KCC20State a_change = {
            amount: token_a_group.inputs.mine.amount - (n_a1 + n_a2),
            owner: byte[32](payer),
            owner_scheme: OWNER_P2PK_SCHNORR,
            borrow_scheme: BORROW_DISABLED,
            borrow_guard: ZERO32,
            extension_commitment: token_a_group.inputs.mine.extension_commitment,
        };
        KCC20State b_merchant = {
            amount: amount_b,
            owner: merchant,
            owner_scheme: OWNER_P2PK_SCHNORR,
            borrow_scheme: BORROW_DISABLED,
            borrow_guard: ZERO32,
            extension_commitment: b_extension,
        };
        require token_a_group.outputs become {
            delivery1 <- self.token_a_type(a_delivery1),
            delivery2 <- self.token_a_type(a_delivery2),
            change <- self.token_a_type(a_change),
        };
        require token_b_group.outputs become {
            escrow_change <- self.token_b_type(b_change),
            merchant_out <- self.token_b_type(b_merchant),
        };
    }

    // From the deadline on, anyone may send the intent's KAS back to the payer
    // at out j, less at most EXPIRE_MAX_FEE. The locked tokens go whole, with
    // their whole carrier, to the payer's key at out j + 1. Input j + 1 is
    // those tokens, so no other input's positional rule can claim out j + 1.
    entry expire()
    observes token_a_group by self.token_a {
        inputs {
            mine: self.token_a_type,
        }
        outputs {
            back: self.token_a_type,
        }
    }
    emits none {
        int me = this.activeInputIndex;
        require(tx.time >= deadline);
        require(tx.outputs[me].scriptPubKey == byte[](new ScriptPubKeyP2PK(payer)));
        require(tx.outputs[me].value + EXPIRE_MAX_FEE >= self.value);
        require(OpCovInputIdx(token_a, 0) == me + 1);
        require(OpCovOutputIdx(token_a, 0) == me + 1);
        require(tx.outputs[me + 1].value >= token_a_group.inputs.mine.value);
        own_tokens(token_a_group.inputs.mine.owner, token_a_group.inputs.mine.owner_scheme, token_a_group.inputs.mine.borrow_scheme, byte[32](self.cov_id));
        require(token_a_group.inputs.mine.amount == lock_amount);
        require(token_a_group.inputs.mine.extension_commitment == lock_extension);
        KCC20State back_state = {
            amount: token_a_group.inputs.mine.amount,
            owner: byte[32](payer),
            owner_scheme: OWNER_P2PK_SCHNORR,
            borrow_scheme: BORROW_DISABLED,
            borrow_guard: ZERO32,
            extension_commitment: token_a_group.inputs.mine.extension_commitment,
        };
        require token_a_group.outputs become {
            back <- self.token_a_type(back_state),
        };
    }

    // The payer, at any time. Input j + 1 must be the lock, the one token
    // input of the locked token, read under the intent's handle and owned by
    // this intent's id. The cancel ends the intent covenant, and tokens owned
    // by its id could never move afterwards. The payer's SIGHASH_ALL
    // signature chooses where the one token output goes.
    entry cancel(sig s)
    observes token_a_group by self.token_a {
        inputs {
            mine: self.token_a_type,
        }
        outputs {
            back: self.token_a_type,
        }
    }
    emits none {
        require_cancel_sig(s, payer);
        require(OpCovInputIdx(token_a, 0) == this.activeInputIndex + 1);
        require(token_a_group.inputs.mine.owner == byte[32](self.cov_id));
        require(token_a_group.inputs.mine.owner_scheme == OWNER_COVENANT_ID);
        require(token_a_group.inputs.mine.borrow_scheme == BORROW_DISABLED);
        require(token_a_group.inputs.mine.amount == lock_amount);
        require(token_a_group.inputs.mine.extension_commitment == lock_extension);
    }
}

actor TokenSwap_swap2_out owns TokenSwapState {
    // 2 bids and 2 asks. Every bid but the last ends, and every ask but
    // the last is sold out. The last bid ends, and the last ask is sold out.
    entry swap2_out(cov_id bid1_covid, cov_id bid2_covid, cov_id ask1_covid, cov_id ask2_covid, int n_a1, int n_a2)
    observes bids1 by bid1_covid {
        inputs {
            bid: KOBOrders::KobBid,
        }
        outputs {
        }
    }
    observes bids2 by bid2_covid {
        inputs {
            bid: KOBOrders::KobBid,
        }
        outputs {
        }
    }
    observes asks1 by ask1_covid {
        inputs {
            ask: KOBOrders::KobAsk,
        }
        outputs {
        }
    }
    observes asks2 by ask2_covid {
        inputs {
            ask: KOBOrders::KobAsk,
        }
        outputs {
        }
    }
    observes token_a_group by self.token_a {
        inputs {
            mine: self.token_a_type,
        }
        outputs {
            delivery1: self.token_a_type,
            delivery2: self.token_a_type,
            change: self.token_a_type,
        }
    }
    observes token_b_group by self.token_b {
        inputs {
            escrow1: self.token_b_type,
            escrow2: self.token_b_type,
        }
        outputs {
            merchant_out: self.token_b_type,
        }
    }
    emits none {
        require(tx.inputs.length == this.activeInputIndex + 1);
        require(OpTxInputScriptSigSubstr(OpCovInputIdx(ask1_covid, 0), 0, 1) == byte[](0x08));
        require(int(byte[8](OpTxInputScriptSigSubstr(OpCovInputIdx(ask1_covid, 0), 1, 9))) > 0);
        require(OpTxInputScriptSigSubstr(OpCovInputIdx(ask2_covid, 0), 0, 1) == byte[](0x08));
        require(int(byte[8](OpTxInputScriptSigSubstr(OpCovInputIdx(ask2_covid, 0), 1, 9))) > 0);

        require(token_a != token_b);
        own_tokens(token_a_group.inputs.mine.owner, token_a_group.inputs.mine.owner_scheme, token_a_group.inputs.mine.borrow_scheme, byte[32](self.cov_id));
        require(token_a_group.inputs.mine.amount == lock_amount);
        require(token_a_group.inputs.mine.extension_commitment == lock_extension);
        bid_fits(bids1.inputs.bid.tokenCovId, byte[32](token_a), n_a1);
        bid_fits(bids2.inputs.bid.tokenCovId, byte[32](token_a), n_a2);
        require(n_a1 + n_a2 <= max_sell_a);
        require(n_a1 + n_a2 <= token_a_group.inputs.mine.amount);
        require(token_b_group.inputs.escrow1.amount + token_b_group.inputs.escrow2.amount == amount_b);
        require(token_b_group.inputs.escrow1.extension_commitment == b_extension);
        require(token_b_group.inputs.escrow2.extension_commitment == b_extension);
        ask_fits(asks1.inputs.ask.tokenCovId, asks1.inputs.ask.amountLeft, token_b_group.inputs.escrow1.owner, token_b_group.inputs.escrow1.owner_scheme, token_b_group.inputs.escrow1.amount, byte[32](ask1_covid), byte[32](token_b), token_b_group.inputs.escrow1.amount);
        ask_fits(asks2.inputs.ask.tokenCovId, asks2.inputs.ask.amountLeft, token_b_group.inputs.escrow2.owner, token_b_group.inputs.escrow2.owner_scheme, token_b_group.inputs.escrow2.amount, byte[32](ask2_covid), byte[32](token_b), token_b_group.inputs.escrow2.amount);

        require(OpCovOutputIdx(token_b, 0) == this.activeInputIndex);
        require(OpCovOutputIdx(token_a, 2) == this.activeInputIndex + 1);

        KCC20State a_delivery1 = {
            amount: n_a1,
            owner: byte[32](bids1.inputs.bid.maker),
            owner_scheme: OWNER_P2PK_SCHNORR,
            borrow_scheme: BORROW_DISABLED,
            borrow_guard: ZERO32,
            extension_commitment: bids1.inputs.bid.extensionCommitment,
        };
        KCC20State a_delivery2 = {
            amount: n_a2,
            owner: byte[32](bids2.inputs.bid.maker),
            owner_scheme: OWNER_P2PK_SCHNORR,
            borrow_scheme: BORROW_DISABLED,
            borrow_guard: ZERO32,
            extension_commitment: bids2.inputs.bid.extensionCommitment,
        };
        KCC20State a_change = {
            amount: token_a_group.inputs.mine.amount - (n_a1 + n_a2),
            owner: byte[32](payer),
            owner_scheme: OWNER_P2PK_SCHNORR,
            borrow_scheme: BORROW_DISABLED,
            borrow_guard: ZERO32,
            extension_commitment: token_a_group.inputs.mine.extension_commitment,
        };
        KCC20State b_merchant = {
            amount: amount_b,
            owner: merchant,
            owner_scheme: OWNER_P2PK_SCHNORR,
            borrow_scheme: BORROW_DISABLED,
            borrow_guard: ZERO32,
            extension_commitment: b_extension,
        };
        require token_a_group.outputs become {
            delivery1 <- self.token_a_type(a_delivery1),
            delivery2 <- self.token_a_type(a_delivery2),
            change <- self.token_a_type(a_change),
        };
        require token_b_group.outputs become {
            merchant_out <- self.token_b_type(b_merchant),
        };
    }

    // From the deadline on, anyone may send the intent's KAS back to the payer
    // at out j, less at most EXPIRE_MAX_FEE. The locked tokens go whole, with
    // their whole carrier, to the payer's key at out j + 1. Input j + 1 is
    // those tokens, so no other input's positional rule can claim out j + 1.
    entry expire()
    observes token_a_group by self.token_a {
        inputs {
            mine: self.token_a_type,
        }
        outputs {
            back: self.token_a_type,
        }
    }
    emits none {
        int me = this.activeInputIndex;
        require(tx.time >= deadline);
        require(tx.outputs[me].scriptPubKey == byte[](new ScriptPubKeyP2PK(payer)));
        require(tx.outputs[me].value + EXPIRE_MAX_FEE >= self.value);
        require(OpCovInputIdx(token_a, 0) == me + 1);
        require(OpCovOutputIdx(token_a, 0) == me + 1);
        require(tx.outputs[me + 1].value >= token_a_group.inputs.mine.value);
        own_tokens(token_a_group.inputs.mine.owner, token_a_group.inputs.mine.owner_scheme, token_a_group.inputs.mine.borrow_scheme, byte[32](self.cov_id));
        require(token_a_group.inputs.mine.amount == lock_amount);
        require(token_a_group.inputs.mine.extension_commitment == lock_extension);
        KCC20State back_state = {
            amount: token_a_group.inputs.mine.amount,
            owner: byte[32](payer),
            owner_scheme: OWNER_P2PK_SCHNORR,
            borrow_scheme: BORROW_DISABLED,
            borrow_guard: ZERO32,
            extension_commitment: token_a_group.inputs.mine.extension_commitment,
        };
        require token_a_group.outputs become {
            back <- self.token_a_type(back_state),
        };
    }

    // The payer, at any time. Input j + 1 must be the lock, the one token
    // input of the locked token, read under the intent's handle and owned by
    // this intent's id. The cancel ends the intent covenant, and tokens owned
    // by its id could never move afterwards. The payer's SIGHASH_ALL
    // signature chooses where the one token output goes.
    entry cancel(sig s)
    observes token_a_group by self.token_a {
        inputs {
            mine: self.token_a_type,
        }
        outputs {
            back: self.token_a_type,
        }
    }
    emits none {
        require_cancel_sig(s, payer);
        require(OpCovInputIdx(token_a, 0) == this.activeInputIndex + 1);
        require(token_a_group.inputs.mine.owner == byte[32](self.cov_id));
        require(token_a_group.inputs.mine.owner_scheme == OWNER_COVENANT_ID);
        require(token_a_group.inputs.mine.borrow_scheme == BORROW_DISABLED);
        require(token_a_group.inputs.mine.amount == lock_amount);
        require(token_a_group.inputs.mine.extension_commitment == lock_extension);
    }
}

// ---------------------------------------- TokenToKasKron

// TokenToKas with a KRON token A, read as KronTokenState under the intent's
// KRON handle and sold into KobBidKrons. The transaction shape and the rules
// are the same. The lock is id_type 2, owned by the intent. The deliveries
// and the change are id_type 3.

actor TokenToKasKron_sell owns TokenToKasKronState {
    // One bid, which rests. n1 base units go into it, and it continues.
    entry sell(cov_id bid1_covid, int n1)
    observes book1 by bid1_covid {
        inputs {
            bid: KOBOrdersKron::KobBidKron,
        }
        outputs {
            next: KOBOrdersKron::KobBidKron,
        }
    }
    observes token by self.token_covid {
        inputs {
            mine: self.token_type,
        }
        outputs {
            delivery1: self.token_type,
            change: self.token_type,
        }
    }
    emits none {
        int me = this.activeInputIndex;
        require(tx.inputs.length == me + 1);
        own_kron(token.inputs.mine.owner, token.inputs.mine.id_type, token.inputs.mine.is_minter, byte[32](self.cov_id));
        require(token.inputs.mine.amount == lock_amount);
        bid_fits(book1.inputs.bid.tokenCovId, byte[32](token_covid), n1);
        require(book1.inputs.bid.tif == 0);
        int sold = n1;
        require(sold <= max_sell);
        require(sold <= token.inputs.mine.amount);

        require(tx.outputs[me].scriptPubKey == byte[](new ScriptPubKeyP2PK(merchant)));
        require(tx.outputs[me].value >= merchant_kas);
        require(OpCovOutputIdx(token_covid, 1) == me + 1);

        KronTokenState delivery1_state = {
            owner: byte[32](book1.inputs.bid.maker),
            id_type: KRON_ID_ADDRESS,
            amount: n1,
            is_minter: 0x00,
        };
        KronTokenState change_state = {
            owner: byte[32](payer),
            id_type: KRON_ID_ADDRESS,
            amount: token.inputs.mine.amount - sold,
            is_minter: 0x00,
        };
        require token.outputs become {
            delivery1 <- self.token_type(delivery1_state),
            change <- self.token_type(change_state),
        };
    }

    // From the deadline on, anyone may send the intent's KAS back to the payer
    // at out j, less at most EXPIRE_MAX_FEE. The locked tokens go whole, with
    // their whole carrier, to the payer's key at out j + 1. Input j + 1 is
    // those tokens, so no other input's positional rule can claim out j + 1.
    entry expire()
    observes token by self.token_covid {
        inputs {
            mine: self.token_type,
        }
        outputs {
            back: self.token_type,
        }
    }
    emits none {
        int me = this.activeInputIndex;
        require(tx.time >= deadline);
        require(tx.outputs[me].scriptPubKey == byte[](new ScriptPubKeyP2PK(payer)));
        require(tx.outputs[me].value + EXPIRE_MAX_FEE >= self.value);
        require(OpCovInputIdx(token_covid, 0) == me + 1);
        require(OpCovOutputIdx(token_covid, 0) == me + 1);
        require(tx.outputs[me + 1].value >= token.inputs.mine.value);
        own_kron(token.inputs.mine.owner, token.inputs.mine.id_type, token.inputs.mine.is_minter, byte[32](self.cov_id));
        require(token.inputs.mine.amount == lock_amount);
        KronTokenState back_state = {
            owner: byte[32](payer),
            id_type: KRON_ID_ADDRESS,
            amount: token.inputs.mine.amount,
            is_minter: 0x00,
        };
        require token.outputs become {
            back <- self.token_type(back_state),
        };
    }

    // The payer, at any time. Input j + 1 must be the lock, the one token
    // input of the locked token, read under the intent's handle and owned by
    // this intent's id. The cancel ends the intent covenant, and tokens owned
    // by its id could never move afterwards. The payer's SIGHASH_ALL
    // signature chooses where the one token output goes.
    entry cancel(sig s)
    observes token by self.token_covid {
        inputs {
            mine: self.token_type,
        }
        outputs {
            back: self.token_type,
        }
    }
    emits none {
        require_cancel_sig(s, payer);
        require(OpCovInputIdx(token_covid, 0) == this.activeInputIndex + 1);
        require(token.inputs.mine.owner == byte[32](self.cov_id));
        require(token.inputs.mine.id_type == KRON_ID_COVENANT);
        require(token.inputs.mine.is_minter == 0x00);
        require(token.inputs.mine.amount == lock_amount);
    }
}

actor TokenToKasKron_sell_out owns TokenToKasKronState {
    // One bid, which ends, exhausted, IOC or FOK. n1 base units go into it.
    entry sell_out(cov_id bid1_covid, int n1)
    observes book1 by bid1_covid {
        inputs {
            bid: KOBOrdersKron::KobBidKron,
        }
        outputs {
        }
    }
    observes token by self.token_covid {
        inputs {
            mine: self.token_type,
        }
        outputs {
            delivery1: self.token_type,
            change: self.token_type,
        }
    }
    emits none {
        int me = this.activeInputIndex;
        require(tx.inputs.length == me + 1);
        own_kron(token.inputs.mine.owner, token.inputs.mine.id_type, token.inputs.mine.is_minter, byte[32](self.cov_id));
        require(token.inputs.mine.amount == lock_amount);
        bid_fits(book1.inputs.bid.tokenCovId, byte[32](token_covid), n1);
        int sold = n1;
        require(sold <= max_sell);
        require(sold <= token.inputs.mine.amount);

        require(tx.outputs[me].scriptPubKey == byte[](new ScriptPubKeyP2PK(merchant)));
        require(tx.outputs[me].value >= merchant_kas);
        require(OpCovOutputIdx(token_covid, 1) == me + 1);

        KronTokenState delivery1_state = {
            owner: byte[32](book1.inputs.bid.maker),
            id_type: KRON_ID_ADDRESS,
            amount: n1,
            is_minter: 0x00,
        };
        KronTokenState change_state = {
            owner: byte[32](payer),
            id_type: KRON_ID_ADDRESS,
            amount: token.inputs.mine.amount - sold,
            is_minter: 0x00,
        };
        require token.outputs become {
            delivery1 <- self.token_type(delivery1_state),
            change <- self.token_type(change_state),
        };
    }

    // From the deadline on, anyone may send the intent's KAS back to the payer
    // at out j, less at most EXPIRE_MAX_FEE. The locked tokens go whole, with
    // their whole carrier, to the payer's key at out j + 1. Input j + 1 is
    // those tokens, so no other input's positional rule can claim out j + 1.
    entry expire()
    observes token by self.token_covid {
        inputs {
            mine: self.token_type,
        }
        outputs {
            back: self.token_type,
        }
    }
    emits none {
        int me = this.activeInputIndex;
        require(tx.time >= deadline);
        require(tx.outputs[me].scriptPubKey == byte[](new ScriptPubKeyP2PK(payer)));
        require(tx.outputs[me].value + EXPIRE_MAX_FEE >= self.value);
        require(OpCovInputIdx(token_covid, 0) == me + 1);
        require(OpCovOutputIdx(token_covid, 0) == me + 1);
        require(tx.outputs[me + 1].value >= token.inputs.mine.value);
        own_kron(token.inputs.mine.owner, token.inputs.mine.id_type, token.inputs.mine.is_minter, byte[32](self.cov_id));
        require(token.inputs.mine.amount == lock_amount);
        KronTokenState back_state = {
            owner: byte[32](payer),
            id_type: KRON_ID_ADDRESS,
            amount: token.inputs.mine.amount,
            is_minter: 0x00,
        };
        require token.outputs become {
            back <- self.token_type(back_state),
        };
    }

    // The payer, at any time. Input j + 1 must be the lock, the one token
    // input of the locked token, read under the intent's handle and owned by
    // this intent's id. The cancel ends the intent covenant, and tokens owned
    // by its id could never move afterwards. The payer's SIGHASH_ALL
    // signature chooses where the one token output goes.
    entry cancel(sig s)
    observes token by self.token_covid {
        inputs {
            mine: self.token_type,
        }
        outputs {
            back: self.token_type,
        }
    }
    emits none {
        require_cancel_sig(s, payer);
        require(OpCovInputIdx(token_covid, 0) == this.activeInputIndex + 1);
        require(token.inputs.mine.owner == byte[32](self.cov_id));
        require(token.inputs.mine.id_type == KRON_ID_COVENANT);
        require(token.inputs.mine.is_minter == 0x00);
        require(token.inputs.mine.amount == lock_amount);
    }
}

