fn require_cancel_sig(sig s, pubkey key) {
    byte[] sb = byte[](s);
    require(sb.length == 65);
    require(sb[64] == SIGHASH_ALL);
    require(checkSig(s, key));
}

// Quote value of n base units at rate r, in quote units per `scale` base
// units, rounded up. This is KobAsk.quoteOf with c = scale - 1, the rounding
// of what a maker receives. The split keeps every partial product below the
// result or scale^2, so it is exact without a 128-bit product while
// scale^2 + scale < 2^63. The engine fails on an overflow and never wraps.
// It needs n, r >= 0 and scale > 0.
fn quote_up(int n, int r, int scale) -> int {
    int m = n % scale;
    int q = n / scale;
    return q * r + m * (r / scale) + (m * (r % scale) + scale - 1) / scale;
}

// One ask leg. The ask, with the token, scale, amountLeft and price of its
// state, sells the token the intent buys. `esc` is its custody, owned by the
// ask's covenant id and holding exactly amountLeft base units. `take` base
// units are bought, more than 0 and at most the custody. The ask enforces
// its own minimum fill.
//
// Returns the KAS the ask may demand for them at its quote,
// ceil(take * price / scale). A decaying ask, a tip or a keeper's crossing
// spread only lower what the maker takes. An ask whose priceEnd lies above
// its price demands more, and then the keeper pays the difference, never the
// payer. Each leg is at most MAX_SOMPI, so the sum over three legs cannot
// overflow.
fn ask_leg(byte[32] a_token, int a_scale, int a_amount_left, int a_price, byte[32] esc_owner, byte esc_scheme, int esc_amount, byte[32] ask_id, byte[32] token, int take) -> int {
    require(a_token == token);
    require(esc_owner == ask_id);
    require(esc_scheme == OWNER_COVENANT_ID);
    require(esc_amount == a_amount_left);
    require(take > 0);
    require(take <= esc_amount);
    require(a_scale > 0);
    require(a_price >= 0);
    int pay = quote_up(take, a_price, a_scale);
    require(pay <= MAX_SOMPI);
    return pay;
}

// The custody checks of ask_leg without the price. In TokenSwap the KAS in
// between is the keeper's.
fn ask_fits(byte[32] a_token, int a_amount_left, byte[32] esc_owner, byte esc_scheme, int esc_amount, byte[32] ask_id, byte[32] token, int take) {
    require(a_token == token);
    require(esc_owner == ask_id);
    require(esc_scheme == OWNER_COVENANT_ID);
    require(esc_amount == a_amount_left);
    require(take > 0);
    require(take <= esc_amount);
}

// The lock of a KCC-20 token A. It is owned by the intent's covenant id, and
// no borrow path may move it without the intent.
fn own_tokens(byte[32] owner, byte owner_scheme, byte borrow_scheme, byte[32] intent_id) {
    require(owner == intent_id);
    require(owner_scheme == OWNER_COVENANT_ID);
    require(borrow_scheme == BORROW_DISABLED);
}

// The lock of a KRON token A. It is owned by the intent's covenant id, with
// id_type 2, so the intent's presence authorises it. It is never a minter
// UTXO.
fn own_kron(byte[32] owner, byte id_type, byte is_minter, byte[32] intent_id) {
    require(owner == intent_id);
    require(id_type == KRON_ID_COVENANT);
    require(is_minter == 0x00);
}

// One bid leg. The bid buys the token the intent sells, and `n` base units,
// more than 0, go into it. The bid enforces its own minimum fill and pins its
// delivery at n, and the router pins the same output. A rising bid never
// pays less than its quote, and the router bounds what the payer gets, not
// what a bid pays. So the payer's bounds hold at any t.
fn bid_fits(byte[32] b_token, byte[32] token, int n) {
    require(b_token == token);
    require(n > 0);
}
// ---------------------------------------- KasToToken

// Transaction shape of every buy:
//   in      .., ask_1 .. ask_k, escrow_1 .. escrow_k (token B), .., the
//           intent at j, the last input
//   out i_m the maker payout of ask_m
//   rest    also the continuation of ask_k and the escrow change
//   out j   the payer's change
//   out j+1 the merchant's delivery, the last token B output

actor KasToToken_buy owns KasToTokenState {
    // One ask, which rests and continues with amountLeft - amount.
    entry buy(cov_id ask1_covid)
    observes book1 by ask1_covid {
        inputs {
            ask: KOBOrders::KobAsk,
        }
        outputs {
            next: KOBOrders::KobAsk,
        }
    }
    observes token by self.token_covid {
        inputs {
            escrow1: self.token_type,
        }
        outputs {
            change: self.token_type,
            merchant: self.token_type,
        }
    }
    emits none {
        int me = this.activeInputIndex;
        require(tx.inputs.length == me + 1);
        require(OpTxInputScriptSigSubstr(OpCovInputIdx(ask1_covid, 0), 0, 1) == byte[](0x08));
        require(int(byte[8](OpTxInputScriptSigSubstr(OpCovInputIdx(ask1_covid, 0), 1, 9))) > 0);
        int take1 = amount;
        require(take1 < token.inputs.escrow1.amount);
        require(book1.inputs.ask.tif == 0);
        require(token.inputs.escrow1.extension_commitment == b_extension);
        int pay1 = ask_leg(book1.inputs.ask.tokenCovId, book1.inputs.ask.scale, book1.inputs.ask.amountLeft, book1.inputs.ask.price, token.inputs.escrow1.owner, token.inputs.escrow1.owner_scheme, token.inputs.escrow1.amount, byte[32](ask1_covid), byte[32](token_covid), take1);
        int pay = pay1;
        require(pay <= max_pay);

        require(tx.outputs[me].scriptPubKey == byte[](new ScriptPubKeyP2PK(payer)));
        require(tx.outputs[me].value + pay + max_extra >= self.value);
        require(OpCovOutputIdx(token_covid, 1) == me + 1);

        KCC20State change_state = {
            amount: token.inputs.escrow1.amount - take1,
            owner: token.inputs.escrow1.owner,
            owner_scheme: OWNER_COVENANT_ID,
            borrow_scheme: token.inputs.escrow1.borrow_scheme,
            borrow_guard: token.inputs.escrow1.borrow_guard,
            extension_commitment: token.inputs.escrow1.extension_commitment,
        };
        KCC20State merchant_state = {
            amount: amount,
            owner: merchant,
            owner_scheme: OWNER_P2PK_SCHNORR,
            borrow_scheme: BORROW_DISABLED,
            borrow_guard: ZERO32,
            extension_commitment: b_extension,
        };
        require token.outputs become {
            change <- self.token_type(change_state),
            merchant <- self.token_type(merchant_state),
        };
    }

    // From the deadline on, anyone may send the intent's KAS back to the payer
    // at out j, less at most EXPIRE_MAX_FEE.
    entry expire() emits none {
        int me = this.activeInputIndex;
        require(tx.time >= deadline);
        require(tx.outputs[me].scriptPubKey == byte[](new ScriptPubKeyP2PK(payer)));
        require(tx.outputs[me].value + EXPIRE_MAX_FEE >= self.value);
    }

    entry cancel(sig s) emits none {
        require_cancel_sig(s, payer);
    }
}

actor KasToToken_buy_out owns KasToTokenState {
    // One ask, sold out. The merchant gets its whole custody, and the ask ends.
    entry buy_out(cov_id ask1_covid)
    observes book1 by ask1_covid {
