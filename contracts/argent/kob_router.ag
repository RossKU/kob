    }

    // The payer, any time. Input j + 1 must be the lock, the one token input of the locked token, read under the
    // intent's handle: owned by this intent's id. The cancel ends the intent covenant, and tokens owned by its id
    // could never move afterwards. Where they go (the one token output) is the payer's signed choice (SIGHASH_ALL).
    entry cancel(sig s)
    observes token by self.token_covid {
        inputs {
            mine: self.token_type,
        }
        outputs {
            back: self.token_type,
        }
    }
    emits none {
        require_cancel_sig(s, payer);
        require(OpCovInputIdx(token_covid, 0) == this.activeInputIndex + 1);
        require(token.inputs.mine.owner == byte[32](self.cov_id));
        require(token.inputs.mine.owner_scheme == OWNER_COVENANT_ID);
