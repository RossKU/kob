actor TokenSwap_swap_ask_out owns TokenSwapState {
    // 1 bid(s) (the last one RESTING, the others END) and 1 ask(s) (the last one SOLD OUT, the others SOLD OUT).
    entry swap_ask_out(cov_id bid1_covid, cov_id ask1_covid, int n_a1)
    observes bids1 by bid1_covid {
