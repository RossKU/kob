    }
}

actor TokenToKas_sell2 owns TokenToKasState {
    // 2 bids: the first 1 END, the last RESTS. n1 .. n2 base units, at most max_sell in all.
    entry sell2(cov_id bid1_covid, cov_id bid2_covid, int n1, int n2)
    observes book1 by bid1_covid {
        inputs {
            bid: KOBOrders::KobBid,
        }
        outputs {
        }
    }
    observes book2 by bid2_covid {
        inputs {
            bid: KOBOrders::KobBid,
        }
        outputs {
            next: KOBOrders::KobBid,
        }
    }
    observes token by self.token_covid {
        inputs {
            mine: self.token_type,
        }
        outputs {
            delivery1: self.token_type,
            delivery2: self.token_type,
            change: self.token_type,
        }
    }
    emits none {
        int me = this.activeInputIndex;
        require(tx.inputs.length == me + 1);
        own_tokens(token.inputs.mine.owner, token.inputs.mine.owner_scheme, token.inputs.mine.borrow_scheme, byte[32](self.cov_id));
        require(token.inputs.mine.amount == lock_amount);
        require(token.inputs.mine.extension_commitment == lock_extension);
        bid_fits(book1.inputs.bid.tokenCovId, byte[32](token_covid), n1);
        bid_fits(book2.inputs.bid.tokenCovId, byte[32](token_covid), n2);
        require(book2.inputs.bid.tif == 0);
        int sold = n1 + n2;
        require(sold <= max_sell);
        require(sold <= token.inputs.mine.amount);

        require(tx.outputs[me].scriptPubKey == byte[](new ScriptPubKeyP2PK(merchant)));
        require(tx.outputs[me].value >= merchant_kas);
        require(OpCovOutputIdx(token_covid, 2) == me + 1);

        KCC20State delivery1_state = {
