// ---------------------------------------- TokenSwapKron

// TokenSwap with a KRON token A, sold into KobBidKrons. Token B is KCC-20
// and is bought from KobAsks as in TokenSwap.

actor TokenSwapKron_swap owns TokenSwapKronState {
    // One bid and one ask. The bid rests, and the ask rests.
    entry swap(cov_id bid1_covid, cov_id ask1_covid, int n_a1)
    observes bids1 by bid1_covid {
        inputs {
            bid: KOBOrdersKron::KobBidKron,
        }
        outputs {
            next: KOBOrdersKron::KobBidKron,
        }
    }
    observes asks1 by ask1_covid {
        inputs {
            ask: KOBOrders::KobAsk,
        }
        outputs {
            next: KOBOrders::KobAsk,
        }
    }
    observes token_a_group by self.token_a {
        inputs {
            mine: self.token_a_type,
        }
        outputs {
            delivery1: self.token_a_type,
            change: self.token_a_type,
        }
    }
    observes token_b_group by self.token_b {
        inputs {
            escrow1: self.token_b_type,
        }
        outputs {
            escrow_change: self.token_b_type,
            merchant_out: self.token_b_type,
        }
    }
    emits none {
        require(tx.inputs.length == this.activeInputIndex + 1);
        require(OpTxInputScriptSigSubstr(OpCovInputIdx(ask1_covid, 0), 0, 1) == byte[](0x08));
        require(int(byte[8](OpTxInputScriptSigSubstr(OpCovInputIdx(ask1_covid, 0), 1, 9))) > 0);

        require(token_a != token_b);
        own_kron(token_a_group.inputs.mine.owner, token_a_group.inputs.mine.id_type, token_a_group.inputs.mine.is_minter, byte[32](self.cov_id));
        require(token_a_group.inputs.mine.amount == lock_amount);
        bid_fits(bids1.inputs.bid.tokenCovId, byte[32](token_a), n_a1);
        require(bids1.inputs.bid.tif == 0);
        require(n_a1 <= max_sell_a);
        require(n_a1 <= token_a_group.inputs.mine.amount);
        require(amount_b < token_b_group.inputs.escrow1.amount);
        require(asks1.inputs.ask.tif == 0);
        require(token_b_group.inputs.escrow1.extension_commitment == b_extension);
        ask_fits(asks1.inputs.ask.tokenCovId, asks1.inputs.ask.amountLeft, token_b_group.inputs.escrow1.owner, token_b_group.inputs.escrow1.owner_scheme, token_b_group.inputs.escrow1.amount, byte[32](ask1_covid), byte[32](token_b), amount_b);

        require(OpCovOutputIdx(token_b, 1) == this.activeInputIndex);
        require(OpCovOutputIdx(token_a, 1) == this.activeInputIndex + 1);

        KCC20State b_change = {
            amount: token_b_group.inputs.escrow1.amount - amount_b,
            owner: token_b_group.inputs.escrow1.owner,
            owner_scheme: OWNER_COVENANT_ID,
            borrow_scheme: token_b_group.inputs.escrow1.borrow_scheme,
            borrow_guard: token_b_group.inputs.escrow1.borrow_guard,
            extension_commitment: token_b_group.inputs.escrow1.extension_commitment,
        };
        KronTokenState a_delivery1 = {
            owner: byte[32](bids1.inputs.bid.maker),
            id_type: KRON_ID_ADDRESS,
            amount: n_a1,
            is_minter: 0x00,
        };
        KronTokenState a_change = {
            owner: byte[32](payer),
            id_type: KRON_ID_ADDRESS,
            amount: token_a_group.inputs.mine.amount - (n_a1),
            is_minter: 0x00,
        };
        KCC20State b_merchant = {
            amount: amount_b,
            owner: merchant,
            owner_scheme: OWNER_P2PK_SCHNORR,
            borrow_scheme: BORROW_DISABLED,
            borrow_guard: ZERO32,
            extension_commitment: b_extension,
        };
        require token_a_group.outputs become {
            delivery1 <- self.token_a_type(a_delivery1),
            change <- self.token_a_type(a_change),
        };
        require token_b_group.outputs become {
            escrow_change <- self.token_b_type(b_change),
            merchant_out <- self.token_b_type(b_merchant),
        };
    }

    // From the deadline on, anyone may send the intent's KAS back to the payer
    // at out j, less at most EXPIRE_MAX_FEE. The locked tokens go whole, with
    // their whole carrier, to the payer's key at out j + 1. Input j + 1 is
    // those tokens, so no other input's positional rule can claim out j + 1.
    entry expire()
    observes token_a_group by self.token_a {
        inputs {
            mine: self.token_a_type,
        }
        outputs {
            back: self.token_a_type,
        }
    }
    emits none {
        int me = this.activeInputIndex;
        require(tx.time >= deadline);
        require(tx.outputs[me].scriptPubKey == byte[](new ScriptPubKeyP2PK(payer)));
        require(tx.outputs[me].value + EXPIRE_MAX_FEE >= self.value);
        require(OpCovInputIdx(token_a, 0) == me + 1);
        require(OpCovOutputIdx(token_a, 0) == me + 1);
        require(tx.outputs[me + 1].value >= token_a_group.inputs.mine.value);
        own_kron(token_a_group.inputs.mine.owner, token_a_group.inputs.mine.id_type, token_a_group.inputs.mine.is_minter, byte[32](self.cov_id));
        require(token_a_group.inputs.mine.amount == lock_amount);
        KronTokenState back_state = {
            owner: byte[32](payer),
            id_type: KRON_ID_ADDRESS,
            amount: token_a_group.inputs.mine.amount,
            is_minter: 0x00,
        };
        require token_a_group.outputs become {
            back <- self.token_a_type(back_state),
        };
    }

    // The payer, at any time. Input j + 1 must be the lock, the one token
    // input of the locked token, read under the intent's handle and owned by
    // this intent's id. The cancel ends the intent covenant, and tokens owned
    // by its id could never move afterwards. The payer's SIGHASH_ALL
    // signature chooses where the one token output goes.
    entry cancel(sig s)
    observes token_a_group by self.token_a {
        inputs {
            mine: self.token_a_type,
        }
        outputs {
            back: self.token_a_type,
        }
    }
    emits none {
        require_cancel_sig(s, payer);
        require(OpCovInputIdx(token_a, 0) == this.activeInputIndex + 1);
        require(token_a_group.inputs.mine.owner == byte[32](self.cov_id));
        require(token_a_group.inputs.mine.id_type == KRON_ID_COVENANT);
        require(token_a_group.inputs.mine.is_minter == 0x00);
        require(token_a_group.inputs.mine.amount == lock_amount);
    }
}

