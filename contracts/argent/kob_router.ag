        int pay2 = ask_leg(book2.inputs.ask.tokenCovId, book2.inputs.ask.scale, book2.inputs.ask.amountLeft, book2.inputs.ask.price, token.inputs.escrow2.owner, token.inputs.escrow2.owner_scheme, token.inputs.escrow2.amount, byte[32](ask2_covid), byte[32](token_covid), token.inputs.escrow2.amount);
        int pay3 = ask_leg(book3.inputs.ask.tokenCovId, book3.inputs.ask.scale, book3.inputs.ask.amountLeft, book3.inputs.ask.price, token.inputs.escrow3.owner, token.inputs.escrow3.owner_scheme, token.inputs.escrow3.amount, byte[32](ask3_covid), byte[32](token_covid), token.inputs.escrow3.amount);
        int pay = pay1 + pay2 + pay3;
        require(pay <= max_pay);

        require(tx.outputs[me].scriptPubKey == byte[](new ScriptPubKeyP2PK(payer)));
        require(tx.outputs[me].value + pay + max_extra >= self.value);
        require(OpCovOutputIdx(token_covid, 0) == me + 1);

        KCC20State merchant_state = {
            amount: amount,
            owner: merchant,
            owner_scheme: OWNER_P2PK_SCHNORR,
            borrow_scheme: BORROW_DISABLED,
            borrow_guard: ZERO32,
            extension_commitment: b_extension,
        };
        require token.outputs become {
            merchant <- self.token_type(merchant_state),
        };
    }

    // From the deadline on, anyone may send the intent's KAS back to the payer
    // at out j, less at most EXPIRE_MAX_FEE.
    entry expire() emits none {
        int me = this.activeInputIndex;
        require(tx.time >= deadline);
        require(tx.outputs[me].scriptPubKey == byte[](new ScriptPubKeyP2PK(payer)));
        require(tx.outputs[me].value + EXPIRE_MAX_FEE >= self.value);
    }

    entry cancel(sig s) emits none {
        require_cancel_sig(s, payer);
    }
