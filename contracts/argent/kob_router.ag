    cov_id token_covid;             // token B
    actor_type<KCC20State> token_type; // token B's program
    int amount;                     // exact token base units the merchant receives
    int max_pay;                    // max sompi the asks may demand at their quotes
    int max_extra;                  // max sompi for carriers + network fee
    byte[32] b_extension;           // B PIN: extension_commitment of token B (the offer's; every escrow and the delivery)
    temporal deadline;              // unix ms: from here on anyone may expire the intent
}

