            borrow_guard: ZERO32,
            extension_commitment: b_extension,
        };
        require token.outputs become {
            change <- self.token_type(change_state),
            merchant <- self.token_type(merchant_state),
        };
    }

    // From the deadline on, anyone may send the intent's KAS back to the payer
    // at out j, less at most EXPIRE_MAX_FEE.
    entry expire() emits none {
        int me = this.activeInputIndex;
        require(tx.time >= deadline);
        require(tx.outputs[me].scriptPubKey == byte[](new ScriptPubKeyP2PK(payer)));
        require(tx.outputs[me].value + EXPIRE_MAX_FEE >= self.value);
    }

    entry cancel(sig s) emits none {
        require_cancel_sig(s, payer);
    }
}

actor KasToToken_buy2_out owns KasToTokenState {
    // 2 asks, all sold out.
    entry buy2_out(cov_id ask1_covid, cov_id ask2_covid)
    observes book1 by ask1_covid {
        inputs {
            ask: KOBOrders::KobAsk,
        }
        outputs {
        }
    }
    observes book2 by ask2_covid {
        inputs {
            ask: KOBOrders::KobAsk,
        }
        outputs {
        }
    }
    observes token by self.token_covid {
        inputs {
            escrow1: self.token_type,
            escrow2: self.token_type,
        }
        outputs {
            merchant: self.token_type,
        }
    }
    emits none {
        int me = this.activeInputIndex;
        require(tx.inputs.length == me + 1);
        require(OpTxInputScriptSigSubstr(OpCovInputIdx(ask1_covid, 0), 0, 1) == byte[](0x08));
        require(int(byte[8](OpTxInputScriptSigSubstr(OpCovInputIdx(ask1_covid, 0), 1, 9))) > 0);
        require(OpTxInputScriptSigSubstr(OpCovInputIdx(ask2_covid, 0), 0, 1) == byte[](0x08));
        require(int(byte[8](OpTxInputScriptSigSubstr(OpCovInputIdx(ask2_covid, 0), 1, 9))) > 0);
        require(token.inputs.escrow1.amount + token.inputs.escrow2.amount == amount);
        require(token.inputs.escrow1.extension_commitment == b_extension);
        require(token.inputs.escrow2.extension_commitment == b_extension);
        int pay1 = ask_leg(book1.inputs.ask.tokenCovId, book1.inputs.ask.scale, book1.inputs.ask.amountLeft, book1.inputs.ask.price, token.inputs.escrow1.owner, token.inputs.escrow1.owner_scheme, token.inputs.escrow1.amount, byte[32](ask1_covid), byte[32](token_covid), token.inputs.escrow1.amount);
        int pay2 = ask_leg(book2.inputs.ask.tokenCovId, book2.inputs.ask.scale, book2.inputs.ask.amountLeft, book2.inputs.ask.price, token.inputs.escrow2.owner, token.inputs.escrow2.owner_scheme, token.inputs.escrow2.amount, byte[32](ask2_covid), byte[32](token_covid), token.inputs.escrow2.amount);
        int pay = pay1 + pay2;
        require(pay <= max_pay);

        require(tx.outputs[me].scriptPubKey == byte[](new ScriptPubKeyP2PK(payer)));
        require(tx.outputs[me].value + pay + max_extra >= self.value);
        require(OpCovOutputIdx(token_covid, 0) == me + 1);

        KCC20State merchant_state = {
            amount: amount,
            owner: merchant,
            owner_scheme: OWNER_P2PK_SCHNORR,
            borrow_scheme: BORROW_DISABLED,
            borrow_guard: ZERO32,
            extension_commitment: b_extension,
        };
        require token.outputs become {
            merchant <- self.token_type(merchant_state),
        };
    }

    // From the deadline on, anyone may send the intent's KAS back to the payer
    // at out j, less at most EXPIRE_MAX_FEE.
    entry expire() emits none {
        int me = this.activeInputIndex;
        require(tx.time >= deadline);
        require(tx.outputs[me].scriptPubKey == byte[](new ScriptPubKeyP2PK(payer)));
        require(tx.outputs[me].value + EXPIRE_MAX_FEE >= self.value);
    }

    entry cancel(sig s) emits none {
        require_cancel_sig(s, payer);
    }
}

actor KasToToken_buy3 owns KasToTokenState {
    // 3 asks. All but the last are sold out, and the last one rests.
    entry buy3(cov_id ask1_covid, cov_id ask2_covid, cov_id ask3_covid)
    observes book1 by ask1_covid {
        inputs {
            ask: KOBOrders::KobAsk,
        }
        outputs {
        }
    }
    observes book2 by ask2_covid {
        inputs {
            ask: KOBOrders::KobAsk,
        }
        outputs {
        }
    }
    observes book3 by ask3_covid {
        inputs {
            ask: KOBOrders::KobAsk,
        }
        outputs {
            next: KOBOrders::KobAsk,
        }
    }
    observes token by self.token_covid {
        inputs {
            escrow1: self.token_type,
            escrow2: self.token_type,
            escrow3: self.token_type,
        }
        outputs {
            change: self.token_type,
            merchant: self.token_type,
        }
    }
    emits none {
        int me = this.activeInputIndex;
        require(tx.inputs.length == me + 1);
        require(OpTxInputScriptSigSubstr(OpCovInputIdx(ask1_covid, 0), 0, 1) == byte[](0x08));
        require(int(byte[8](OpTxInputScriptSigSubstr(OpCovInputIdx(ask1_covid, 0), 1, 9))) > 0);
        require(OpTxInputScriptSigSubstr(OpCovInputIdx(ask2_covid, 0), 0, 1) == byte[](0x08));
        require(int(byte[8](OpTxInputScriptSigSubstr(OpCovInputIdx(ask2_covid, 0), 1, 9))) > 0);
        require(OpTxInputScriptSigSubstr(OpCovInputIdx(ask3_covid, 0), 0, 1) == byte[](0x08));
        require(int(byte[8](OpTxInputScriptSigSubstr(OpCovInputIdx(ask3_covid, 0), 1, 9))) > 0);
        int take3 = amount - token.inputs.escrow1.amount - token.inputs.escrow2.amount;
        require(take3 < token.inputs.escrow3.amount);
        require(book3.inputs.ask.tif == 0);
        require(token.inputs.escrow1.extension_commitment == b_extension);
        require(token.inputs.escrow2.extension_commitment == b_extension);
        require(token.inputs.escrow3.extension_commitment == b_extension);
        int pay1 = ask_leg(book1.inputs.ask.tokenCovId, book1.inputs.ask.scale, book1.inputs.ask.amountLeft, book1.inputs.ask.price, token.inputs.escrow1.owner, token.inputs.escrow1.owner_scheme, token.inputs.escrow1.amount, byte[32](ask1_covid), byte[32](token_covid), token.inputs.escrow1.amount);
        int pay2 = ask_leg(book2.inputs.ask.tokenCovId, book2.inputs.ask.scale, book2.inputs.ask.amountLeft, book2.inputs.ask.price, token.inputs.escrow2.owner, token.inputs.escrow2.owner_scheme, token.inputs.escrow2.amount, byte[32](ask2_covid), byte[32](token_covid), token.inputs.escrow2.amount);
        int pay3 = ask_leg(book3.inputs.ask.tokenCovId, book3.inputs.ask.scale, book3.inputs.ask.amountLeft, book3.inputs.ask.price, token.inputs.escrow3.owner, token.inputs.escrow3.owner_scheme, token.inputs.escrow3.amount, byte[32](ask3_covid), byte[32](token_covid), take3);
        int pay = pay1 + pay2 + pay3;
        require(pay <= max_pay);

        require(tx.outputs[me].scriptPubKey == byte[](new ScriptPubKeyP2PK(payer)));
        require(tx.outputs[me].value + pay + max_extra >= self.value);
        require(OpCovOutputIdx(token_covid, 1) == me + 1);

        KCC20State change_state = {
            amount: token.inputs.escrow3.amount - take3,
            owner: token.inputs.escrow3.owner,
            owner_scheme: OWNER_COVENANT_ID,
            borrow_scheme: token.inputs.escrow3.borrow_scheme,
            borrow_guard: token.inputs.escrow3.borrow_guard,
            extension_commitment: token.inputs.escrow3.extension_commitment,
        };
        KCC20State merchant_state = {
            amount: amount,
            owner: merchant,
            owner_scheme: OWNER_P2PK_SCHNORR,
            borrow_scheme: BORROW_DISABLED,
            borrow_guard: ZERO32,
            extension_commitment: b_extension,
        };
        require token.outputs become {
            change <- self.token_type(change_state),
            merchant <- self.token_type(merchant_state),
        };
    }

    // From the deadline on, anyone may send the intent's KAS back to the payer
    // at out j, less at most EXPIRE_MAX_FEE.
    entry expire() emits none {
        int me = this.activeInputIndex;
        require(tx.time >= deadline);
        require(tx.outputs[me].scriptPubKey == byte[](new ScriptPubKeyP2PK(payer)));
        require(tx.outputs[me].value + EXPIRE_MAX_FEE >= self.value);
    }

    entry cancel(sig s) emits none {
        require_cancel_sig(s, payer);
    }
}

