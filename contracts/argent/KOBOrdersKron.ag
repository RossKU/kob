// KOBOrdersKron: the Argent interface of the two KRON limit orders.
//
// The orders are SilverScript, in contracts/orders/kron/: KobAskKron and
// KobBidKron, the KRON versions of KobAsk and KobBid. As in KOBOrders.ag,
// this file is not their implementation. It declares only each order's state
// layout and its entries, and scripts/build-argent.sh builds it the same way.
// The result is contracts/argent/KOBOrdersKron/artifact.json. What an order
// enforces is in its .sil file and in the tests under crates/kob-tests.
//
// It is a separate app so that the published KOBOrders artifact, and every
// import that pins its id, stays as it is. The router (kob_router.ag)
// imports it by pinned id and observes KobBidKron by closed ICC in its KRON
// intents. KobAskKron is published for other apps. The router buys from no
// KRON ask, because a KRON token is never delivered to an x402 merchant.
//
// KRON has no extension commitment. The two states are those of KobAsk and
// KobBid without extensionCommitment, see contracts/orders/kron/README.md.

state KobAskKronState {
    pubkey maker;
    byte[32] tokenCovId;
    byte[32] tokenTplHash;
    int tplPrefixLen;
    int tplSuffixLen;
    int scale;
    int minFill;
    int price;
    int tip;
    int tif;
    int activeFrom;
    int expiryDaa;
    int refundTip;
    int interval;
    int maxFill;
    int slope;
    int priceEnd;
    int decayStep;
    int amountLeft;
}

state KobBidKronState {
    pubkey maker;
    byte[32] tokenCovId;
    byte[32] tokenTplHash;
    int tplPrefixLen;
    int tplSuffixLen;
    int scale;
    int minFill;
    int price;
    int tip;
    int tif;
    int activeFrom;
    int expiryDaa;
    int refundTip;
    int reserve;
    int deliveryCarrier;
    int interval;
    int maxFill;
    int slope;
    int priceEnd;
    int decayStep;
}

actor KobAskKron owns KobAskKronState {
    // Fill n base units, or refund the order with n == 0. nb is n as 8 bytes,
    // little-endian. A GTC rest continues with amountLeft - n. A sold-out,
    // IOC or FOK fill ends the order.
    entry settle(byte[8] nb, int tokenIn, int tokOut, int t) emits {
        next: KobAskKron[0..=1],
    } {
        KobAskKronState[] cont;
        unrestricted(next[0].value);
        become next <- KobAskKron[](cont);
    }

    entry cancel(sig s) emits none {
        require(checkSig(s, maker));
    }
}

actor KobBidKron owns KobBidKronState {
    // Buy n base units. nb is n as 8 bytes, little-endian. The KRON delivery to
    // the maker, of id_type 3, sits at the bid's own input index. A GTC bid
    // with buying power left continues byte-identically. Otherwise it ends.
    entry fill(byte[8] nb, int tokenTplIn, int t) emits {
        next: KobBidKron[0..=1],
    } {
        KobBidKronState[] cont;
        unrestricted(next[0].value);
        become next <- KobBidKron[](cont);
    }

    entry cancel(sig s) emits none {
        require(checkSig(s, maker));
    }

    entry refund() emits none {
        require(true);
    }
}

app KOBOrdersKron {
    actor KobAskKron;
    actor KobBidKron;
}
