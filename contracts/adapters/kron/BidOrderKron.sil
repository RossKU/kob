pragma silverscript ^0.1.0;

// KRON twin of contracts/orders/BidOrder.sil (first-generation order; entries, state and
// invariants as there). Differences:
//   - delivery output i is a genuine KRON token UTXO {owner maker, id_type 3 (address presence),
//     amount n*lotSize, is_minter 0} in the legacy 46-byte layout
//       0x20 owner[32] | 0x01 id_type | 0x08 amount (LE i64) | 0x01 is_minter
//     instead of a KCC-20 state with owner_scheme 0x00;
//   - no `extensionCommitment` constructor argument (the KRON layout has none).
contract BidOrderKron(
    pubkey maker,
    byte[32] tokenCovId,
    byte[32] tokenTplHash,
    int tplPrefixLen,
    int tplSuffixLen,
    int lotSize,
    int lotPrice,
    int reserve,
    int deliveryCarrier,
    int expiryDaa,
    int refundTip
) {
    struct KronState {
        byte[32] owner;
        byte id_type;
        int amount;
        byte is_minter;
    }

    byte constant TYPE_ADDRESS = 0x03;
    byte constant NOT_MINTER = 0x00;
    byte constant SIGHASH_ALL = 0x01;
    int constant MAX_SOMPI = 2900000000000000000;
    int constant MAX_INT = 9223372036854775807;

    entry fill(int n, int tokenTplIn) {
        byte[32] selfId = OpInputCovenantId(this.activeInputIndex);
        require(OpCovInputCount(selfId) == 1);

        require(lotSize > 0);
        require(lotPrice > 0);
        require(reserve >= 0);
        require(deliveryCarrier >= 0);
        require(deliveryCarrier <= MAX_SOMPI);
        require(n > 0);
        require(n <= MAX_SOMPI / lotPrice);
        require(n <= MAX_INT / lotSize);
        int pay = n * lotPrice;
        int get = n * lotSize;

        int inValue = tx.inputs[this.activeInputIndex].value;
        int left = inValue - pay;
        require(left >= reserve);

        int out = this.activeInputIndex;
        require(OpInputCovenantId(tokenTplIn) == tokenCovId);
        validateOutputStateWithInputTemplate(
            out,
            KronState {
                owner: byte[32](maker),
                id_type: TYPE_ADDRESS,
                amount: get,
                is_minter: NOT_MINTER
            },
            tokenTplIn, tplPrefixLen, tplSuffixLen, tokenTplHash
        );
        require(OpOutputCovenantId(out) == tokenCovId);

        if (left - reserve >= lotPrice + deliveryCarrier) {
            require(OpCovOutputCount(selfId) == 1);
            int selfOut = OpCovOutputIdx(selfId, 0);
            require(tx.outputs[selfOut].scriptPubKey == this.activeScriptPubKey);
            require(tx.outputs[selfOut].value >= left - deliveryCarrier);
            require(tx.outputs[out].value >= deliveryCarrier);
        } else {
            require(OpCovOutputCount(selfId) == 0);
            require(tx.outputs[out].value >= left);
        }
    }

    entry cancel(sig s) {
        byte[] sb = byte[](s);
        require(sb.length == 65);
        require(sb[64] == SIGHASH_ALL);
        require(checkSig(s, maker));
    }

    entry refund() {
        require(tx.daa >= expiryDaa);
        byte[32] selfId = OpInputCovenantId(this.activeInputIndex);
        require(OpCovInputCount(selfId) == 1);
        require(OpCovOutputCount(selfId) == 0);
        require(refundTip >= 0);
        require(refundTip <= MAX_SOMPI);
        int out = this.activeInputIndex;
        require(tx.outputs[out].scriptPubKey == byte[](new ScriptPubKeyP2PK(maker)));
        require(tx.outputs[out].value + refundTip >= tx.inputs[this.activeInputIndex].value);
    }
}
