pragma silverscript ^0.1.0;

// KobPair: a limit order on a pair of tokens A/B.
//
// A is the base token and B the quote token. The order is an amount of A at a
// limit price in base units of B per whole A. One template serves both sides
// and both token families. It holds the token it sells, S, in an exact
// custody and receives the token it buys, T, at its own output.
//   side 1, ASK  Sells A for B. S is A and T is B.
//   side 2, BID  Buys A with B. S is a B escrow and T is A.
// The specification is docs/spec/order-types.md, "Pair orders".
//
// Entries:
//   settle(nb, custIn, tTplIn, t, sOut, tOut), with n = int(nb)
//     n > 0   Fill n base units of A. Anyone, once tx.daa >= activeFrom.
//     n == 0  Refund the whole custody to the maker at output i. Anyone, once
//             tx.daa >= min(expiryDaa, UTXO DAA + 90 days, IOC/FOK kill).
//   cancel(sig)
//     Maker only, signed with SIGHASH_ALL.
//
// custIn is the custody input, and tTplIn any input of T, the source of its
// template bytes. sOut is the S a fill releases and tOut the T the maker
// receives. t is the decay time, proven by CLTV. nb is a fixed 8-byte push
// and the first argument, so pair conditionals can read n at sigscript[1..9).
//
// Only amountLeft, the base units of A still to trade, and custody, the exact
// amount of S held, are mutable. sExt is the KCC-20 extension commitment of
// the custody, zero for KRON.
//
// The order checks only its own terms: what it receives and pays, its
// custody, the stray guards of both tokens and its own outputs. A matcher may
// fill it through the KAS books, against opposite pair orders or from its own
// tokens.
contract KobPair(
    pubkey init_maker,
    int init_side,
    byte[32] init_sCovId,
    byte[32] init_sTplHash,
    int init_sPre,
    int init_sSuf,
    int init_sFamily,
    int init_sScale,
    byte[32] init_tCovId,
    byte[32] init_tTplHash,
    int init_tPre,
    int init_tSuf,
    int init_tFamily,
    byte[32] init_tExt,
    int init_tScale,
    int init_minFill,
    int init_price,
    int init_tip,
    int init_tif,
    int init_activeFrom,
    int init_expiryDaa,
    int init_refundTip,
    int init_deliveryCarrier,
    int init_interval,
    int init_maxFill,
    int init_slope,
    int init_priceEnd,
    int init_decayStep,
    int init_amountLeft,
    int init_custody,
    byte[32] init_sExt
) {
    pubkey maker = init_maker;               // T deliveries, S refunds / returns, cancel key
    int side = init_side;                    // 1 ASK (sells base A = S), 2 BID (buys base A = T)
    byte[32] sCovId = init_sCovId;           // the token sold and held (A for an ask, B for a bid)
    byte[32] sTplHash = init_sTplHash;
    int sPre = init_sPre;
    int sSuf = init_sSuf;
    int sFamily = init_sFamily;              // 1 KCC-20, 2 KRON
    int sScale = init_sScale;                // base units per whole S (10^decimals)
    byte[32] tCovId = init_tCovId;           // the token bought (B for an ask, A for a bid)
    byte[32] tTplHash = init_tTplHash;
    int tPre = init_tPre;
    int tSuf = init_tSuf;
    int tFamily = init_tFamily;
    byte[32] tExt = init_tExt;               // KCC-20 extension commitment of the T delivery (0 for KRON)
    int tScale = init_tScale;                // base units per whole T
    int minFill = init_minFill;              // smallest fill (base units of A) unless it takes all that is left
    int price = init_price;                  // limit: B base units per whole A (start price if decaying)
    int tip = init_tip;                      // optional priority tip, sompi per whole A (>= 0), prefunded
    int tif = init_tif;                      // 0 GTC/GTD, 1 IOC, 2 FOK
    int activeFrom = init_activeFrom;
    int expiryDaa = init_expiryDaa;
    int refundTip = init_refundTip;
    int deliveryCarrier = init_deliveryCarrier; // sompi on each T delivery
    int interval = init_interval;            // TWAP / DCA: min DAA between fills (0 = off)
    int maxFill = init_maxFill;              // TWAP / DCA: max base units of A per fill (0 = off)
    int slope = init_slope;                  // decay (ASK down, BID up): B base units per whole A per decayStep (0 = off)
    int priceEnd = init_priceEnd;            // decay bound
    int decayStep = init_decayStep;
    int amountLeft = init_amountLeft;        // base units of A still to trade (mutable)
    int custody = init_custody;              // exact custody of S (mutable; an ask: == amountLeft)
    byte[32] sExt = init_sExt;               // KCC-20 extension commitment of the custody of S (0 for KRON)

    byte constant SCHEME_P2PK = 0x00;
    byte constant SCHEME_COVID = 0x04;
    byte constant KRON_COVID = 0x02;
    byte constant KRON_DELIVERY = 0x03;
    byte constant SIGHASH_ALL = 0x01;
    int constant SIDE_ASK = 1;
    int constant SIDE_BID = 2;
    int constant TIF_GTC = 0;
    int constant TIF_FOK = 2;
    int constant FAM_KCC20 = 1;
    int constant FAM_KRON = 2;
    // An order untouched for 90 days (10 DAA/s) becomes refundable by anyone.
    int constant MAX_IDLE = 77760000;
    // The IOC/FOK kill. Refundable by anyone 60 s (10 DAA/s) after the order
    // became fillable.
    int constant IOC_LIFE = 600;
    // The most token inputs of one token a settle transaction may carry, 8
    // for the 8/8 prototype. A KRON program accepts fewer. The scans over them
    // are unrolled by hand, one line per slot, so raising the cap needs as
    // many lines.
    int constant MAX_TOK_IN = 8;
    // The redeem script is a 1-byte prefix and the 447 B state. amountLeft
    // [398..406) and custody [407..415) are the mutable payloads, so a
    // continuation splices [398..415). The immutable sExt [416..448) follows.
    int constant STATE_END = 415;

    // Quote value of n base units at rate r per d base units. c = 0 rounds
    // down and c = d - 1 rounds up. This is KobAsk.quoteOf with an explicit
    // denominator, exact while d^2 < 2^63 and the result fits.
    function quoteOf(int n, int r, int d, int c) : int {
        int m = n % d;
        int q = n / d;
        return q * r + m * (r / d) + (m * (r % d) + c) / d;
    }

    // Check that input idx is an instance of template (pre, stLen, suf, tpl),
    // as KobAsk.tplRs does, and return its whole redeem script.
    function tplRs(int idx, int pre, int stLen, int suf, byte[32] tpl) : byte[] {
        int size = pre + stLen + suf;
        int base = OpTxInputScriptSigLen(idx) - size;
        byte[] rs = OpTxInputScriptSigSubstr(idx, base, base + size);
        require(tx.inputs[idx].scriptPubKey == byte[](new ScriptPubKeyP2SHFromRedeemScript(rs)));
        require(blake3(byte[](pre as byte[8]) + rs.slice(0, pre) + byte[](suf as byte[8]) + rs.slice(pre + stLen, size)) == tpl);
        return rs;
    }

    // Stray guard, as KobAsk.noStrays, for token `tok`. No input of `tok`
    // other than `cust` may be owned by `me`. Every input of `tok` is an
    // instance of its one template, so its owner sits at a fixed distance
    // `off` from the end of its sigscript, set by the token's family. The scan
    // is unrolled by hand over MAX_TOK_IN slots, one line per input k < cnt.
    function noStrays(byte[32] tok, byte[32] me, int cust, int off) {
        int cnt = OpCovInputCount(tok);
        require(cnt <= MAX_TOK_IN);
        if (cnt > 0) { int x0 = OpCovInputIdx(tok, 0); if (x0 != cust) { int e0 = OpTxInputScriptSigLen(x0) + off; require(byte[32](OpTxInputScriptSigSubstr(x0, e0, e0 + 32)) != me); } }
        if (cnt > 1) { int x1 = OpCovInputIdx(tok, 1); if (x1 != cust) { int e1 = OpTxInputScriptSigLen(x1) + off; require(byte[32](OpTxInputScriptSigSubstr(x1, e1, e1 + 32)) != me); } }
        if (cnt > 2) { int x2 = OpCovInputIdx(tok, 2); if (x2 != cust) { int e2 = OpTxInputScriptSigLen(x2) + off; require(byte[32](OpTxInputScriptSigSubstr(x2, e2, e2 + 32)) != me); } }
        if (cnt > 3) { int x3 = OpCovInputIdx(tok, 3); if (x3 != cust) { int e3 = OpTxInputScriptSigLen(x3) + off; require(byte[32](OpTxInputScriptSigSubstr(x3, e3, e3 + 32)) != me); } }
        if (cnt > 4) { int x4 = OpCovInputIdx(tok, 4); if (x4 != cust) { int e4 = OpTxInputScriptSigLen(x4) + off; require(byte[32](OpTxInputScriptSigSubstr(x4, e4, e4 + 32)) != me); } }
        if (cnt > 5) { int x5 = OpCovInputIdx(tok, 5); if (x5 != cust) { int e5 = OpTxInputScriptSigLen(x5) + off; require(byte[32](OpTxInputScriptSigSubstr(x5, e5, e5 + 32)) != me); } }
        if (cnt > 6) { int x6 = OpCovInputIdx(tok, 6); if (x6 != cust) { int e6 = OpTxInputScriptSigLen(x6) + off; require(byte[32](OpTxInputScriptSigSubstr(x6, e6, e6 + 32)) != me); } }
        if (cnt > 7) { int x7 = OpCovInputIdx(tok, 7); if (x7 != cust) { int e7 = OpTxInputScriptSigLen(x7) + off; require(byte[32](OpTxInputScriptSigSubstr(x7, e7, e7 + 32)) != me); } }
    }

    // The token state of family `fam` holding `amount` for `owner`, in
    // canonical push encoding. cov selects a covenant owner over a key or an
    // address.
    //   KCC-20  owner_scheme 0x04 or 0x00, borrowing disabled, then the given
    //           guard and extension commitment.
    //   KRON    id_type 0x02 or 0x03, is_minter 0.
    function tokenState(int fam, int amount, byte[32] owner, bool cov, byte[] guard, byte[] ext) : byte[] {
        byte[] st = byte[](0x00);
        if (fam == FAM_KRON) {
            byte ty = KRON_DELIVERY;
            if (cov) { ty = KRON_COVID; }
            st = byte[](0x20) + byte[](owner) + byte[](0x01) + byte[](ty) + byte[](0x08) + byte[](amount as byte[8]) + byte[](0x0100);
        } else {
            byte sc = SCHEME_P2PK;
            if (cov) { sc = SCHEME_COVID; }
            st = byte[](0x08) + byte[](amount as byte[8]) + byte[](0x20) + byte[](owner) + byte[](0x01) + byte[](sc) + byte[](0x010020)
                + guard + byte[](0x20) + ext;
        }
        return st;
    }

    entry settle(byte[8] nb, int custIn, int tTplIn, int t, int sOut, int tOut) {
        int n = int(nb);
        int self = this.activeInputIndex;
        byte[32] selfId = OpInputCovenantId(self);
        require(OpCovInputCount(selfId) == 1);

        // Custody. One UTXO of S owned by this order's covenant id, with the
        // covenant marker, holding exactly `custody`. Every settle checks it,
        // so a fill, a refund and an IOC/FOK end all refuse a stand-in.
        // KCC-20 state, 112 B: amount[1..9) owner[10..42) scheme[43]
        // guard[47..79) ext[80..112). KRON state, 46 B: owner[1..33)
        // id_type[34] amount[36..44) is_minter[45].
        require(OpInputCovenantId(custIn) == sCovId);
        int sLen = 112;
        int sOff = 10 - 112 - sSuf;
        if (sFamily == FAM_KRON) {
            sLen = 46;
            sOff = 1 - 46 - sSuf;
        }
        byte[] trs = tplRs(custIn, sPre, sLen, sSuf, sTplHash);
        byte[] tin = trs.slice(sPre, sPre + sLen);
        int held = 0;
        byte[] guard = byte[](0x00);
        byte[] ext = byte[](0x00);
        if (sFamily == FAM_KRON) {
            require(byte[32](tin.slice(1, 33)) == selfId);
            require(tin.slice(33, 36) == byte[](0x010208));
            require(tin.slice(44, 46) == byte[](0x0100));
            held = int(byte[8](tin.slice(36, 44)));
        } else {
            require(sFamily == FAM_KCC20);
            require(byte[32](tin.slice(10, 42)) == selfId);
            require(tin.slice(43, 46) == byte[](0x040100));
            held = int(byte[8](tin.slice(1, 9)));
            guard = tin.slice(47, 79);
            ext = tin.slice(80, 112);
            // A KCC-20 token is (covenant id, program, extension commitment).
            // Units of S's covenant id with another commitment are another
            // token.
            require(byte[32](ext) == sExt);
        }
        // A pair order always holds a positive custody, because it ends when
        // the custody is used up. So every path pins output i to the maker,
        // a refund included.
        require(custody > 0);
        // quoteOf divides by both scales, and a non-positive scale would
        // round against the maker.
        require(sScale > 0);
        require(tScale > 0);
        // The custody is known by its exact amount, so a stray or dust UTXO
        // sent to this id can never stand in for it. Settle refuses any other
        // S input owned by this id. Strays are inert, and only the maker's
        // cancel can move them.
        require(held == custody);
        noStrays(sCovId, selfId, custIn, sOff);

        // The carriers are the KAS on the order and custody UTXOs.
        int carriers = tx.inputs[self].value + tx.inputs[custIn].value;
        int outAmount = custody;
        byte[32] outOwner = byte[32](maker);
        bool rest = false;
        int outIdx = self;
        int utxoDaa = OpTxInputDaaScore(self);

        if (n == 0) {
            // Refund. Due at the earliest of expiryDaa, 90 days idle and, for
            // every tif but GTC, IOC_LIFE after the order became fillable. A
            // covenant cannot prove an upper time bound on a fill, so the
            // IOC/FOK kill is a refund that anyone may send. A fill that lands
            // first still pays the maker's limit.
            int idleEnd = utxoDaa + MAX_IDLE;
            if (tif != TIF_GTC) {
                int kill = utxoDaa;
                if (activeFrom > kill) { kill = activeFrom; }
                kill = kill + IOC_LIFE;
                if (kill < idleEnd) { idleEnd = kill; }
            }
            if (expiryDaa < idleEnd) { idleEnd = expiryDaa; }
            require(tx.daa >= idleEnd);
            // The order ends. An output still bound to its covenant id could
            // move later strays. The maker gets both carriers back, less at
            // most refundTip.
            require(refundTip >= 0);
            require(OpCovOutputCount(selfId) == 0);
            // T strays owned by this id stay put (A == B is refused at placement)
            require(OpCovInputCount(tCovId) == 0);
            require(tx.outputs[self].value + refundTip >= carriers);
        } else {
            require(tx.daa >= activeFrom);
            require(n > 0);
            require(n <= amountLeft);
            // Minimum fill. A fill takes at least minFill unless it takes all
            // that is left. That bounds the number of fills, and so the
            // deliveries and continuations a filler can force on the maker.
            require(n >= minFill || n == amountLeft);
            // Nothing checks the state when the order is created, so a fill
            // checks the fields it relies on.
            require(tip >= 0);
            require(deliveryCarrier >= 0);
            // TWAP or DCA. With interval > 0 the order UTXO must be interval
            // DAA old (CSV), and every fill creates a new one. maxFill > 0
            // caps n.
            if (interval > 0) {
                require(this.ageDaa >= interval);
            }
            require(maxFill == 0 || n <= maxFill);
            int p = price;
            // Decay. Every decayStep DAA after origin the price moves by slope
            // towards priceEnd, down for an ASK and up for a BID. origin is
            // activeFrom, or for a TWAP or DCA the opening of the current
            // slice when that is later, so every slice is its own auction. The
            // filler chooses t, and CLTV proves tx.daa >= t. slope must be
            // positive, so understating t only moves the price towards the
            // maker.
            if (slope != 0) {
                require(slope > 0);
                require(decayStep > 0);
                int origin = activeFrom;
                if (interval > 0) {
                    int slice = utxoDaa + interval;
                    if (slice > origin) { origin = slice; }
                }
                require(tx.daa >= t);
                require(t >= origin);
                int moved = slope * ((t - origin) / decayStep);
                if (side == SIDE_ASK) {
                    p = price - moved;
                    if (p < priceEnd) { p = priceEnd; }
                } else {
                    p = price + moved;
                    if (p > priceEnd) { p = priceEnd; }
                }
            }
            // At a price of zero an ask would give its tokens away.
            require(p > 0);
            int baseScale = tScale;
            if (side == SIDE_ASK) {
                // ASK. It sells exactly n of A and receives at least
                // ceil(n * p / scale(A)) of B, rounded in the maker's favour.
                baseScale = sScale;
                require(sOut == n);
                // Takeable quotes. The custody is the whole amount left, so
                // anyone can take every amount the ask shows.
                require(custody == amountLeft);
                require(tOut >= quoteOf(n, p, sScale, sScale - 1));
            } else {
                // BID. It receives exactly n of A and pays exactly
                // floor(n * p / scale(A)) of B, rounded in the maker's favour.
                require(side == SIDE_BID);
                require(tOut == n);
                // Takeable quotes. The bid pays exactly its quote out of its
                // escrow, so it shows only quotes the escrow funds. Pair
                // conditionals read its fill as trigger evidence, which must
                // be a real trade that anyone could have taken.
                require(sOut == quoteOf(n, p, tScale, 0));
            }
            // The tip is KAS, in sompi per whole A, rounded down. The order
            // UTXO prefunds it.
            int tipKas = quoteOf(n, tip, baseScale, 0);
            outAmount = custody - sOut;
            require(outAmount >= 0);

            // Stray guard on T. Settle refuses every input of T owned by this
            // id, and T strays are inert.
            int tOff = 10 - 112 - tSuf;
            int tLen = 112;
            if (tFamily == FAM_KRON) {
                tOff = 1 - 46 - tSuf;
                tLen = 46;
            } else {
                require(tFamily == FAM_KCC20);
            }
            noStrays(tCovId, selfId, -1, tOff);

            // Positional rule. The maker's T is delivered at output i, this
            // input's index, so one output can never serve two orders. It is
            // owned by the maker, on T's template, with a zero borrow guard
            // and the commitment tExt. The template bytes come from tTplIn and
            // are checked by hash, so they need no P2SH check of tTplIn.
            require(OpInputCovenantId(tTplIn) == tCovId);
            int tbase = OpTxInputScriptSigLen(tTplIn) - (tPre + tLen + tSuf);
            byte[] tpre = OpTxInputScriptSigSubstr(tTplIn, tbase, tbase + tPre);
            byte[] tsuf = OpTxInputScriptSigSubstr(tTplIn, tbase + tPre + tLen, tbase + tPre + tLen + tSuf);
            require(blake3(byte[](tPre as byte[8]) + tpre + byte[](tSuf as byte[8]) + tsuf) == tTplHash);
            require(tx.outputs[self].scriptPubKey == byte[](new ScriptPubKeyP2SHFromRedeemScript(
                tpre + tokenState(tFamily, tOut, byte[32](maker), false, byte[](0 as byte[8]) + byte[](0 as byte[8]) + byte[](0 as byte[8]) + byte[](0 as byte[8]), byte[](tExt)) + tsuf
            )));
            require(OpOutputCovenantId(self) == tCovId);

            if (amountLeft - n > 0 && tif == TIF_GTC) {
                // The rest continues this script with amountLeft - n and
                // custody - sOut. The continuation is the only output bound to
                // this covenant id, and the custody rest stays at custIn.
                require(outAmount > 0);
                require(OpCovOutputCount(selfId) == 1);
                int selfOut = OpCovOutputIdx(selfId, 0);
                int len = OpTxInputScriptSigLen(self);
                byte[] me = OpTxInputScriptSigSubstr(self, len - this.bytecodeSize, len);
                require(tx.outputs[selfOut].scriptPubKey == byte[](new ScriptPubKeyP2SHFromRedeemScript(
                    me.slice(0, STATE_END - 17) + byte[]((amountLeft - n) as byte[8]) + byte[](0x08) + byte[](outAmount as byte[8])
                        + me.slice(STATE_END, this.bytecodeSize)
                )));
                // the order funds its own delivery carrier and tip (no filler-funded carrier wall)
                require(tx.inputs[self].value >= deliveryCarrier + tipKas);
                require(tx.outputs[selfOut].value >= tx.inputs[self].value - deliveryCarrier - tipKas);
                require(tx.outputs[custIn].value >= tx.inputs[custIn].value);
                require(tx.outputs[self].value >= deliveryCarrier);
                outOwner = selfId;
                rest = true;
                outIdx = custIn;
            } else {
                // The order ends when it is done or is not GTC. FOK needs a
                // full fill. No output may stay bound to the covenant id. What
                // is left of the custody returns to the maker at the custody's
                // index with its carrier. No other order can claim that slot,
                // because custody inputs are distinct per order. Output i then
                // keeps the order's KAS, less the tip.
                require(tif != TIF_FOK || amountLeft == n);
                require(OpCovOutputCount(selfId) == 0);
                if (outAmount > 0) {
                    require(tx.outputs[custIn].value >= tx.inputs[custIn].value);
                    require(tx.outputs[self].value >= tx.inputs[self].value - tipKas);
                    outIdx = custIn;
                } else {
                    // No S is left. Output i gets both carriers, less the tip.
                    require(tx.outputs[self].value >= carriers - tipKas);
                }
            }
        }

        if (outAmount > 0) {
            // Pin the only output of S this order allows: the refund, the rest
            // or the return. It is on the custody's own template, with the
            // custody's guard and extension, and bound to S's covenant id.
            require(tx.outputs[outIdx].scriptPubKey == byte[](new ScriptPubKeyP2SHFromRedeemScript(
                trs.slice(0, sPre) + tokenState(sFamily, outAmount, outOwner, rest, guard, ext) + trs.slice(sPre + sLen, trs.length)
            )));
            require(OpOutputCovenantId(outIdx) == sCovId);
        }
    }

    // Cancel. The maker's SIGHASH_ALL signature covers every output, so the
    // maker routes the custody and any strays.
    entry cancel(sig s) {
        byte[] sb = byte[](s);
        require(sb.length == 65);
        require(sb[64] == SIGHASH_ALL);
        require(checkSig(s, maker));
    }
}
