pragma silverscript ^0.1.0;
// KOB variant (not upstream): proposal P2 holder program. Identical to ../KCC20Ref.sil except
// that the delegator path accepts a leader only if it is this template or the KCC20Batch
// batch-leader template (constructor constants B_TPL / B_PRE / B_SUF), replacing the unused
// direct read of the leader state. Generated by kob_protocol::kcc20::kcc20_p2_holder_source.

// Provenance (not KOB code):
//   Reference KCC-20 fungible token, 3,090 B standalone program with a 112 B state.
//   Source: https://github.com/argent-lang/kcc20-reference , pull request #1 (unmerged),
//   commit 600646873ebfa2ec87a8ae57783c9912caf52857, contracts/kcc20.ag compiled with argentc
//   (the resulting SilverScript is included verbatim below).
//   License: ISC, as declared in that repository's Cargo.toml (no LICENSE file at that commit).
//   Status: draft KCC-20 layout, NOT AUDITED. The KOB tests and the fixed-supply issue tool use
//   the standalone form only (the PublicMint variant is layout-incompatible with KOB orders).
// Generated by argentc. Do not edit by hand.

contract KCC20(
    byte[32] B_TPL,
    int B_PRE,
    int B_SUF,
    int init_amount,
    byte[32] init_owner,
    byte init_owner_scheme,
    byte init_borrow_scheme,
    byte[32] init_borrow_guard,
    byte[32] init_extension_commitment
) {
    // :: shared constants
    byte constant OWNER_P2PK_SCHNORR = 0x00;
    byte constant OWNER_P2PKH_SCHNORR = 0x01;
    byte constant OWNER_P2PKH_ECDSA = 0x02;
    byte constant OWNER_P2SH = 0x03;
    byte constant OWNER_COVENANT_ID = 0x04;
    byte constant PATH_NORMAL = 0x00;
    byte constant PATH_BORROW = 0x01;
    byte constant BORROW_DISABLED = 0x00;
    byte constant BORROW_AMOUNT_THRESHOLD = 0x01;
    byte constant BORROW_SCHNORR_SIGNATURE = 0x02;
    byte constant BORROW_HASH_CHAIN = 0x03;
    int constant MAX_DELEGATES = 2;
    int constant MAX_TOKEN_OUTPUTS = 3;

    // :: state layouts

    // :: global functions (isolated using the gen__glob_ namespace)
    function require_valid_owner_scheme(byte gen__glob_owner_scheme) {
        require(
            gen__glob_owner_scheme == OWNER_P2PK_SCHNORR
                || gen__glob_owner_scheme == OWNER_P2PKH_SCHNORR
                || gen__glob_owner_scheme == OWNER_P2PKH_ECDSA
                || gen__glob_owner_scheme == OWNER_P2SH
                || gen__glob_owner_scheme == OWNER_COVENANT_ID
        );
    }
    function require_valid_borrow_scheme(byte gen__glob_borrow_scheme) {
        require(
            gen__glob_borrow_scheme == BORROW_DISABLED
                || gen__glob_borrow_scheme == BORROW_AMOUNT_THRESHOLD
                || gen__glob_borrow_scheme == BORROW_SCHNORR_SIGNATURE
                || gen__glob_borrow_scheme == BORROW_HASH_CHAIN
        );
    }
    function p2pkh_hash(byte[] gen__glob_public_key) : byte[32] {
        return blake3(gen__glob_public_key);
    }
    function require_owner_authorized(byte[32] gen__glob_owner, byte gen__glob_owner_scheme, byte[] gen__glob_witness) {
        if (gen__glob_owner_scheme == OWNER_P2PK_SCHNORR) {
            // The byte[65] conversion below implicitly validates the witness length.
            require(checkSig(
                sig(byte[65](gen__glob_witness)),
                pubkey(gen__glob_owner)
            ));
        } else if (gen__glob_owner_scheme == OWNER_P2PKH_SCHNORR) {
            require(gen__glob_witness.length == 97);

            pubkey gen__glob_owner_public_key = pubkey(byte[32](gen__glob_witness.slice(0, 32)));
            sig gen__glob_owner_signature = sig(byte[65](gen__glob_witness.slice(32, 97)));
            require(p2pkh_hash(byte[](gen__glob_owner_public_key)) == gen__glob_owner);
            require(checkSig(gen__glob_owner_signature, gen__glob_owner_public_key));
        } else if (gen__glob_owner_scheme == OWNER_P2PKH_ECDSA) {
            require(gen__glob_witness.length == 98);

            byte[33] gen__glob_owner_public_key = byte[33](gen__glob_witness.slice(0, 33));
            sig gen__glob_owner_signature = sig(byte[65](gen__glob_witness.slice(33, 98)));
            require(p2pkh_hash(byte[](gen__glob_owner_public_key)) == gen__glob_owner);
            require(checkSigEcdsa(gen__glob_owner_signature, gen__glob_owner_public_key));
        } else if (gen__glob_owner_scheme == OWNER_P2SH) {
            require(gen__glob_witness.length == 1);
            int gen__glob_authority_input_index = unsigned(gen__glob_witness[0]);
            require(
                tx.inputs[gen__glob_authority_input_index].scriptPubKey
                    == byte[](new ScriptPubKeyP2SH(gen__glob_owner))
            );
        } else if (gen__glob_owner_scheme == OWNER_COVENANT_ID) {
            require(gen__glob_witness.length == 0);
            require(OpCovInputCount(gen__glob_owner) > 0);
        } else {
            require(false);
        }
    }

    // :: range helpers
    function gen__checked_range_index(int gen__range_index, int gen__range_count) : int {
        require(gen__range_index >= 0);
        require(gen__range_index < gen__range_count);
        return gen__range_index;
    }

    // :: route templates

    // :: state fields: KCC20
    int amount = init_amount;
    byte[32] owner = init_owner;
    byte owner_scheme = init_owner_scheme;
    byte borrow_scheme = init_borrow_scheme;
    byte[32] borrow_guard = init_borrow_guard;
    byte[32] extension_commitment = init_extension_commitment;

    // :: entrypoints
    // :: leader entry (M:N)
    entry transfer(State[] next_states, byte[] witness) {
        // :: cov inputs
        byte[32] gen__cov_id = OpInputCovenantId(this.activeInputIndex);
        require(OpCovInputIdx(gen__cov_id, 0) == this.activeInputIndex);
        int gen__delegates_count = OpCovInputCount(gen__cov_id) - 1;
        require(gen__delegates_count >= 0);
        require(gen__delegates_count <= 2);
        State[] gen__delegates_authored_states;
        for (gen__delegates_position, 0, gen__delegates_count, 2) {
            int gen__delegates_input_idx = OpCovInputIdx(gen__cov_id, 1 + gen__delegates_position);
            State gen__delegates_state = readInputState(gen__delegates_input_idx);
            gen__delegates_authored_states = gen__delegates_authored_states.append(gen__delegates_state);
        }

        // :: auth outputs
        int gen__next_outputs_output_count = OpAuthOutputCount(this.activeInputIndex);
        require(gen__next_outputs_output_count >= 1);
        require(gen__next_outputs_output_count <= 3);
        // :: leader authorizes all covenant continuations (rule 5)
        require(OpCovOutputCount(gen__cov_id) == OpAuthOutputCount(this.activeInputIndex));

        require(next_states.length == gen__next_outputs_output_count);
        require(witness.length > 0);
        int input_total = amount;
        for (i, 0, gen__delegates_count, MAX_DELEGATES) {
            require(gen__delegates_authored_states[gen__checked_range_index(i, gen__delegates_count)].extension_commitment == extension_commitment);
            input_total = input_total + gen__delegates_authored_states[gen__checked_range_index(i, gen__delegates_count)].amount;
        }
        int output_total = 0;
        for (i, 0, next_states.length, MAX_TOKEN_OUTPUTS) {
            require(next_states[i].amount >= 0);
            require_valid_owner_scheme(next_states[i].owner_scheme);
            require_valid_borrow_scheme(next_states[i].borrow_scheme);
            if (next_states[i].borrow_scheme == BORROW_AMOUNT_THRESHOLD) {
                require(OpBin2Num(next_states[i].borrow_guard.slice(0, 8)) >= 0);
            }
            require(next_states[i].extension_commitment == extension_commitment);
            output_total = output_total + next_states[i].amount;
        }
        require(output_total == input_total);
        byte path = witness[0];
        byte[] path_witness = witness.slice(1, witness.length);
        if (path == PATH_NORMAL) {
            require_owner_authorized(owner, owner_scheme, path_witness);
        } else if (path == PATH_BORROW) {
            int amount_threshold = 0;
            byte[32] next_borrow_guard = borrow_guard;
            if (borrow_scheme == BORROW_DISABLED) {
                require(false);
            } else if (borrow_scheme == BORROW_AMOUNT_THRESHOLD) {
                require(path_witness.length == 0);
                amount_threshold = OpBin2Num(borrow_guard.slice(0, 8));
                require(amount_threshold >= 0);
            } else if (borrow_scheme == BORROW_SCHNORR_SIGNATURE) {
                require(checkSig(
                    sig(byte[65](path_witness)),
                    pubkey(borrow_guard)
                ));
            } else if (borrow_scheme == BORROW_HASH_CHAIN) {
                require(path_witness.length == 129);
                next_borrow_guard = byte[32](path_witness.slice(0, 32));
                pubkey one_time_public_key = pubkey(byte[32](
                    path_witness.slice(32, 64)
                ));
                sig borrow_signature = sig(byte[65](
                    path_witness.slice(64, 129)
                ));
                require(
                    blake3(byte[](
                        next_borrow_guard + byte[](one_time_public_key)
                    )) == borrow_guard
                );
                require(checkSig(borrow_signature, one_time_public_key));
            } else {
                require(false);
            }
            require(next_states[0].owner == owner);
            require(next_states[0].owner_scheme == owner_scheme);
            require(next_states[0].borrow_scheme == borrow_scheme);
            require(next_states[0].borrow_guard == next_borrow_guard);
            int amount_increase = next_states[0].amount - amount;
            require(amount_increase > amount_threshold);
            require(tx.outputs[OpAuthOutputIdx(this.activeInputIndex, 0)].value >= tx.inputs[this.activeInputIndex].value);
        } else {
            require(false);
        }
        require(next_states.length == gen__next_outputs_output_count);
        for (gen__next_outputs_output_position, 0, gen__next_outputs_output_count, 3) {
            State gen__source_next_outputs_kcc20_state = next_states[gen__next_outputs_output_position];
            // :: become KCC20
            validateOutputState(
                OpAuthOutputIdx(this.activeInputIndex, gen__next_outputs_output_position),
                gen__source_next_outputs_kcc20_state
            );
        }
    }

    // :: delegate entry
    entry transfer_delegator(byte[] witness) {
        // :: cov inputs
        byte[32] gen__cov_id = OpInputCovenantId(this.activeInputIndex);
        require(OpCovInputCount(gen__cov_id) >= 2);
        require(OpCovInputIdx(gen__cov_id, 0) != this.activeInputIndex);
        int gen__leader_input_idx = OpCovInputIdx(gen__cov_id, 0); // input KCC20 at cov[0]
        // :: KOB P2 leader allowlist: the leader is this template or the batch-leader template
        int kob__size = this.bytecodeSize;
        int kob__own_len = OpTxInputScriptSigLen(this.activeInputIndex);
        byte[] kob__own = OpTxInputScriptSigSubstr(this.activeInputIndex, kob__own_len - kob__size, kob__own_len);
        int kob__lead_len = OpTxInputScriptSigLen(gen__leader_input_idx);
        byte[] kob__lead = OpTxInputScriptSigSubstr(gen__leader_input_idx, kob__lead_len - kob__size, kob__lead_len);
        bool kob__same = tx.inputs[gen__leader_input_idx].scriptPubKey == byte[](new ScriptPubKeyP2SHFromRedeemScript(kob__lead))
            && kob__lead.slice(0, 1) == kob__own.slice(0, 1)
            && kob__lead.slice(113, kob__size) == kob__own.slice(113, kob__size);
        if (!kob__same) {
            int kob__bsize = B_PRE + 126 + B_SUF;
            byte[] kob__b = OpTxInputScriptSigSubstr(gen__leader_input_idx, kob__lead_len - kob__bsize, kob__lead_len);
            require(tx.inputs[gen__leader_input_idx].scriptPubKey == byte[](new ScriptPubKeyP2SHFromRedeemScript(kob__b)));
            require(
                blake3(byte[](B_PRE as byte[8]) + kob__b.slice(0, B_PRE) + byte[](B_SUF as byte[8]) + kob__b.slice(B_PRE + 126, kob__bsize))
                    == B_TPL
            );
        }

        // :: auth outputs
        require(OpAuthOutputCount(this.activeInputIndex) == 0);

        require_owner_authorized(owner, owner_scheme, witness);
    }

}
