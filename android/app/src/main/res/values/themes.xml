<?xml version="1.0" encoding="utf-8"?>
<!-- Follows the system setting: this is the light theme, values-night/themes.xml the dark one (both framework Material, no library). -->
<resources>
    <style name="Theme.Kob" parent="@android:style/Theme.Material.Light">
        <item name="android:windowBackground">@color/kob_background</item>
        <item name="android:colorBackground">@color/kob_background</item>
        <item name="android:textColorPrimary">@color/kob_text</item>
        <item name="android:textColorSecondary">@color/kob_text_secondary</item>
        <item name="android:textColor">@color/kob_text</item>
        <item name="android:textColorHint">@color/kob_hint</item>
        <item name="android:colorAccent">@color/kob_accent</item>
        <item name="android:colorControlActivated">@color/kob_accent</item>
        <item name="android:statusBarColor">@color/kob_background</item>
        <item name="android:navigationBarColor">@color/kob_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
