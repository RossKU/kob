@@ -0,0 +1,120 @@
+//! Loads published app artifacts as modules (artifact-backed app dependencies).
+//!
+//! `import "./asset/artifact.json" id "<artifact id>";` makes a published app available to the
+//! importing module without its source. The artifact is checked and turned into a declaration-only
+//! module: its states, actor enums, exported actors (no entries) and its app. The bundle builder
+//! links the artifact itself and never compiles the app again.
+
+use std::collections::BTreeMap;
+use std::fs;
+use std::path::{Path, PathBuf};
+
+use crate::artifact::Artifact;
+use crate::compiler::loader::SymbolKind;
+use crate::compiler::model::link::{DeclarationOrigin, linked_field_decl};
+use crate::compiler::syntax::*;
+use crate::error::{ArgentError, Result};
+
+/// An import whose path ends in `.json` names a published app artifact.
+pub(crate) fn is_artifact_path(path: &Path) -> bool {
+    path.extension().is_some_and(|extension| extension.eq_ignore_ascii_case("json"))
+}
+
+/// Reads a published app artifact and checks that it is self-consistent.
+///
+/// Self-consistency only proves that the artifact id is the hash of its content. Anyone can produce
+/// a consistent artifact with the same app name and interfaces but other templates, so the importer
+/// must pin the id it reviewed; see [check_pin].
+pub(super) fn read_artifact(path: &Path) -> Result<Artifact> {
+    let json = fs::read_to_string(path).map_err(|err| ArgentError::at(path, err.to_string()))?;
+    let artifact: Artifact =
+        serde_json::from_str(&json).map_err(|err| ArgentError::at(path, format!("invalid app artifact: {err}")))?;
+    artifact.check_consistency().map_err(|err| ArgentError::at(path, format!("invalid app artifact: {err}")))?;
+    Ok(artifact)
+}
+
+/// An artifact import must name the artifact id it trusts, and the artifact must have that id.
+pub(super) fn check_pin(path: &Path, artifact: &Artifact, pin: Option<&str>) -> Result<()> {
+    match pin {
+        None => Err(ArgentError::at(
+            path,
+            format!(
+                "artifact import of app `{}` has no pinned id; after reviewing the artifact, write `import \"...\" id \"{}\";`",
+                artifact.app, artifact.id
+            ),
+        )),
+        Some(pin) if pin != artifact.id => {
+            Err(ArgentError::at(path, format!("artifact of app `{}` has id {}, the import pins {pin}", artifact.app, artifact.id)))
+        }
+        Some(_) => Ok(()),
+    }
+}
+
+/// Declarations of an artifact-backed module, in artifact order.
+///
+/// The declaration indexes are the identities [artifact_origins] reports, so the importing app and
+/// the linked artifact agree on which states are shared.
+pub(super) fn artifact_module(path: PathBuf, artifact: &Artifact) -> Result<Module> {
+    let expansions = artifact.argent.state_expansions.iter().map(|item| (item.state.as_str(), item)).collect::<BTreeMap<_, _>>();
+    let states = artifact
+        .argent
+        .states
+        .iter()
+        .map(|state| {
+            let expansion = expansions.get(state.name.as_str()).map(|expansion| StateExpansionDecl {
+                base: expansion.base.clone(),
+                digests: expansion
+                    .digests
+                    .iter()
+                    .map(|digest| StateDigestExpansionDecl { field: digest.field.clone(), state: digest.state.clone() })
+                    .collect(),
+            });
+            let fields = if expansion.is_some() {
+                Vec::new()
+            } else {
+                state.fields.iter().map(linked_field_decl).collect::<Result<Vec<_>>>()?
+            };
+            Ok(StateDecl { name: state.name.clone(), fields, expansion })
+        })
+        .collect::<Result<Vec<_>>>()?;
+    let actor_enums = artifact
+        .argent
+        .actor_enums
+        .iter()
+        .map(|item| ActorEnumDecl { name: item.name.clone(), variants: item.variants.clone() })
+        .collect();
+    let mut actors = Vec::new();
+    for interface in &artifact.argent.interfaces.exports {
+        if interface.app != artifact.app {
+            return Err(ArgentError::at(
+                &path,
+                format!("artifact of app `{}` exports actor `{}` for app `{}`", artifact.app, interface.actor, interface.app),
+            ));
+        }
+        let actor = artifact.argent.actors.iter().find(|actor| actor.name == interface.actor).ok_or_else(|| {
+            ArgentError::at(
+                &path,
+                format!("artifact of app `{}` does not describe exported actor `{}`", artifact.app, interface.actor),
+            )
+        })?;
+        actors.push(ActorDecl { name: actor.name.clone(), state: actor.state.clone(), functions: Vec::new(), entries: Vec::new() });
+    }
+    let app = AppDecl { name: artifact.app.clone(), actors: actors.iter().map(|actor| actor.name.clone()).collect() };
+    Ok(Module { path, imports: Vec::new(), consts: Vec::new(), states, functions: Vec::new(), actors, actor_enums, apps: vec![app] })
+}
+
+/// Declaration identities of an artifact-backed module, keyed by the artifact's own names.
+pub(crate) fn artifact_origins(path: &Path, artifact: &Artifact) -> BTreeMap<String, DeclarationOrigin> {
+    let states = artifact.argent.states.iter().map(|state| (state.name.as_str(), SymbolKind::State));
+    let actor_enums = artifact.argent.actor_enums.iter().map(|item| (item.name.as_str(), SymbolKind::ActorEnum));
+    let mut indexes = BTreeMap::<SymbolKind, usize>::new();
+    states
+        .chain(actor_enums)
+        .map(|(name, kind)| {
+            let index = indexes.entry(kind).or_default();
+            let origin = DeclarationOrigin::Source { path: path.to_path_buf(), kind, index: *index };
+            *index += 1;
+            (name.to_string(), origin)
+        })
+        .collect()
+}
